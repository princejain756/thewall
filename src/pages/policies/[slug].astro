---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getContentPage, POLICY_SLUGS } from '../../lib/content/policies';

export function getStaticPaths() {
  return POLICY_SLUGS.map((slug) => ({ params: { slug } }));
}

export const prerender = true;

const { slug } = Astro.params;
const page = getContentPage(slug!);

if (!page) {
  return Astro.redirect('/404');
}
---

<Layout title={`${page.title} — The Wall Records`} description={page.description}>
  <Header />
  <main class="policy-page">
    <article class="policy-page__inner container">
      <nav class="policy-page__breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">/</span>
        <span>{page.title}</span>
      </nav>
      <header class="policy-page__head">
        <span class="label">{page.type === 'faq' ? 'Help' : 'Legal'}</span>
        <h1 class="heading-serif">{page.title}</h1>
        <p class="body-text">{page.description}</p>
      </header>
      <div class="policy-page__body">
        {page.sections.map((section) => (
          <section class="policy-page__section">
            {section.heading && <h2>{section.heading}</h2>}
            <p>{section.body}</p>
          </section>
        ))}
      </div>
      <footer class="policy-page__foot">
        <p>Last updated: July 2026 · <a href="/contact">Contact us</a></p>
      </footer>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  .policy-page {
    padding: 0.75rem var(--section-pad-x) var(--section-pad-y);
  }

  .policy-page__inner {
    max-width: 760px;
    margin: 0 auto;
  }

  .policy-page__breadcrumb {
    display: flex;
    gap: 0.5rem;
    font-size: 0.8rem;
    opacity: 0.7;
    margin-bottom: 1.5rem;
  }

  .policy-page__breadcrumb a:hover {
    opacity: 1;
  }

  .policy-page__head {
    margin-bottom: 2rem;
  }

  .policy-page__head h1 {
    margin: 0.5rem 0 0.75rem;
  }

  .policy-page__section + .policy-page__section {
    margin-top: 1.5rem;
  }

  .policy-page__section h2 {
    font-family: var(--serif);
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
    color: var(--maroon);
  }

  .policy-page__section p {
    font-size: 0.95rem;
    line-height: 1.75;
    opacity: 0.9;
  }

  .policy-page__foot {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(139, 26, 16, 0.12);
    font-size: 0.85rem;
    opacity: 0.75;
  }
</style>
