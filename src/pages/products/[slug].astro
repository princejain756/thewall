---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getProductBySlug, listProducts, parseImages } from '../../lib/products';
import { formatPrice } from '../../lib/db';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/collections/aesthetic');

const product = await getProductBySlug(slug);
if (!product) return Astro.redirect('/404');

const isCustom = product.productType === 'custom' || product.slug === 'best-sister-timeless' || product.slug.includes('memory');
const images = parseImages(product.images);
const defaultMainImage = images[0] || (isCustom ? '/images/custom-made/memory-poster.png' : '/logo.png');

const related = (await listProducts({ collection: product.collectionId || undefined, limit: 8 }))
  .filter((p) => p.id !== product.id)
  .slice(0, 4);

const comboOffers = [
  { tier: 'Buy 4, get 3 free', rate: '≈ ₹68 each', detail: '7 posters for the price of 4' },
  { tier: 'Buy 5, get 5 free', rate: '≈ ₹60 each', detail: '10 posters for the price of 5' },
  { tier: 'Buy 6, get 12 free', rate: '≈ ₹40 each', detail: '18 posters for the price of 6' },
  { tier: 'Buy 10, get 26 free', rate: '≈ ₹33 each', detail: '36 posters for the price of 10' },
];

const customGalleryThumbs = [
  { src: images[0] || '/images/custom-made/memory-poster.png', label: 'Cover Mockup' },
  { src: images[1] || '/images/custom-made/album.png', label: 'Angled Book' },
  { src: images[2] || '/images/custom-made/framed-wall-art.jpg', label: 'Wall Context' },
  { src: images[3] || '/images/custom-made/polaroids.png', label: 'Detail View' },
];
---

<Layout title={`${product.title} — The Wall Records`}>
  <Header />
  <main class={`pdp ${isCustom ? 'pdp--custom' : ''}`}>
    <nav class="pdp__breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      {isCustom ? (
        <>
          <a href="/#custom-made">Custom Made</a>
          <span>/</span>
        </>
      ) : product.collectionName ? (
        <>
          <a href={`/collections/${product.collectionName.toLowerCase().replace(/\s+/g, '-')}`}>{product.collectionName}</a>
          <span>/</span>
        </>
      ) : null}
      <span>{product.title}</span>
    </nav>

    {isCustom ? (
      /* ─── ODD GIRAFFE STYLE CUSTOMIZER PDP ─── */
      <div class="custom-pdp">
        <div class="custom-pdp__stage">
          <!-- Gallery Thumbs -->
          <div class="custom-pdp__thumbs" role="tablist" aria-label="Mockup angles">
            {customGalleryThumbs.map((thumb, idx) => (
              <button
                type="button"
                class={`custom-pdp__thumb ${idx === 0 ? 'custom-pdp__thumb--active' : ''}`}
                data-thumb-src={thumb.src}
                aria-label={thumb.label}
              >
                <img src={thumb.src} alt="" width="68" height="84" loading="lazy" />
              </button>
            ))}
          </div>

          <!-- Main Interactive Mockup -->
          <div class="custom-mockup-wrapper">
            <div class="custom-mockup" id="mockup-canvas" data-theme="cream">
              <div class="custom-mockup__stage-inner">
                <img
                  id="mockup-photo"
                  class="custom-mockup__image"
                  src={images[0] || '/images/custom-made/memory-poster.png'}
                  alt={product.title}
                  width="540"
                  height="540"
                />
              </div>

              <!-- Quick action floating on mockup -->
              <label class="custom-mockup__quick-upload" for="custom-file-input">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/>
                </svg>
                <span>Upload / Change Photo</span>
              </label>
            </div>
            <p class="custom-mockup__hint">Live Mockup Preview · High-Resolution 300 DPI Archival Matte Finish</p>
          </div>
        </div>

        <!-- Customizer Controls -->
        <div class="custom-pdp__controls">
          <span class="custom-pdp__eyebrow">Custom Memory Poster</span>

          <h1 class="custom-pdp__title heading-serif">{product.title}</h1>

          <div class="custom-pdp__rating-bar">
            <div class="custom-pdp__stars" aria-hidden="true">★★★★★</div>
            <span class="custom-pdp__review-count">1,356 reviews</span>
            <span class="custom-pdp__sep">·</span>
            <span class="custom-pdp__rating-tag">Rated 4.8 / 5</span>
          </div>

          <!-- Price -->
          <div class="custom-pdp__price-wrap">
            <span class="custom-pdp__price" id="display-price">{formatPrice(product.variants[0]?.price || 7900)}</span>
            <span class="custom-pdp__compare" id="compare-price">{formatPrice(product.variants[0]?.compareAtPrice || 14900)}</span>
            <span class="custom-pdp__badge">50% Off</span>
          </div>

          <p class="custom-pdp__tax-note">Taxes included. Free Express Shipping on prepaid orders.</p>

          <!-- Format Selector -->
          <div class="custom-pdp__option-group">
            <label class="custom-pdp__option-label" for="format-select">Format</label>
            <div class="custom-pdp__select-wrap">
              <select id="format-select" class="custom-pdp__select">
                <option value="Square" selected>Square (8.5" × 8.5")</option>
                <option value="Portrait A4">Portrait (A4 / A5 Standard)</option>
                <option value="Framed Hardcover">Hardcover Matte Print</option>
                <option value="Gallery Frame">Gallery Framed Poster</option>
              </select>
            </div>
          </div>

          <!-- Size Selector -->
          <div class="custom-pdp__option-group">
            <div class="custom-pdp__label-row">
              <label class="custom-pdp__option-label" for="size-select">Size</label>
              <span class="custom-pdp__size-guide-link" id="view-size-guide" role="button" tabindex="0">A4 & A5 Dimensions</span>
            </div>
            <div class="custom-pdp__size-buttons" id="size-options">
              {product.variants.map((v, i) => (
                <button
                  type="button"
                  class={`custom-size-pill ${i === 0 ? 'custom-size-pill--active' : ''}`}
                  data-size={v.size}
                  data-price={v.price}
                  data-compare={v.compareAtPrice || ''}
                  data-variant-id={v.id}
                >
                  <span class="custom-size-pill__name">{v.size}</span>
                  <span class="custom-size-pill__dim">
                    {v.size === 'A4' ? '8.3" × 11.7"' : v.size === 'A5' ? '5.8" × 8.3"' : v.size === 'Square' ? '8.5" × 8.5"' : '11.7" × 16.5"'}
                  </span>
                </button>
              ))}
            </div>
            <!-- Selected Size Live Dimension Info -->
            <div class="custom-pdp__selected-dim" id="selected-dim-card">
              <div class="custom-pdp__selected-dim-main">
                <span class="custom-pdp__selected-dim-label">Dimensions for <strong id="selected-dim-name">A4</strong>:</span>
                <strong class="custom-pdp__selected-dim-val" id="selected-dim-val">8.3" × 11.7" (210 × 297 mm)</strong>
              </div>
              <div class="custom-pdp__selected-dim-sub">
                <span id="selected-dim-px">Print Resolution: 2480 × 3508 px @ 300 DPI</span>
                <span class="custom-pdp__selected-dim-dot">·</span>
                <span id="selected-dim-desc">Standard wall poster</span>
              </div>
            </div>
          </div>

          <!-- Color Theme Swatches -->
          <div class="custom-pdp__option-group">
            <label class="custom-pdp__option-label">Color Theme</label>
            <div class="custom-pdp__color-swatches" id="color-swatches">
              <button
                type="button"
                class="custom-swatch custom-swatch--active"
                data-color-name="Cream White"
                data-theme="cream"
                style="background-color: #fffaf2;"
                title="Cream White"
                aria-label="Cream White"
              />
              <button
                type="button"
                class="custom-swatch"
                data-color-name="Terracotta Peach"
                data-theme="terracotta"
                style="background-color: #f59c7a;"
                title="Terracotta Peach"
                aria-label="Terracotta Peach"
              />
              <button
                type="button"
                class="custom-swatch"
                data-color-name="Sage Green"
                data-theme="sage"
                style="background-color: #d4ebd0;"
                title="Sage Green"
                aria-label="Sage Green"
              />
              <button
                type="button"
                class="custom-swatch"
                data-color-name="Charcoal Noir"
                data-theme="charcoal"
                style="background-color: #1f2421;"
                title="Charcoal Noir"
                aria-label="Charcoal Noir"
              />
            </div>
            <span class="custom-pdp__color-name" id="selected-color-name">Cream White</span>
          </div>

          <!-- Custom Photo Upload Dropzone -->
          <div class="custom-pdp__upload-box" id="upload-box">
            <input
              type="file"
              id="custom-file-input"
              accept="image/jpeg,image/png,image/webp,image/heic"
              style="display:none;"
            />
            <div class="custom-pdp__upload-inner" id="upload-dropzone">
              <div class="custom-pdp__upload-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <polyline points="21 15 16 10 5 21"/>
                </svg>
              </div>
              <div class="custom-pdp__upload-text">
                <strong id="upload-status-title">Upload your photo for A4 (8.3" × 11.7") print</strong>
                <span id="upload-status-desc">Recommended: 2480 × 3508 px @ 300 DPI (JPG, PNG, HEIC up to 25MB)</span>
              </div>
              <button type="button" class="btn btn--outline custom-pdp__upload-btn" id="trigger-upload-btn">
                Browse Photo
              </button>
            </div>
            <div class="custom-pdp__upload-preview-bar" id="upload-preview-bar" style="display: none;">
              <img id="upload-preview-thumb" src="/images/custom-made/memory-poster.png" alt="" />
              <div class="custom-pdp__upload-file-meta">
                <strong id="upload-filename">photo.jpg</strong>
                <span>Photo ready for high-definition printing</span>
              </div>
              <button type="button" class="custom-pdp__upload-remove" id="remove-uploaded-photo">Remove</button>
            </div>
          </div>

          <!-- Upload Specs Callout (prominent, always visible) -->
          <div class="custom-pdp__spec-callout" role="region" aria-label="Upload specifications">
            <div class="custom-pdp__spec-head">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
                <line x1="9" y1="13" x2="15" y2="13"/>
                <line x1="9" y1="17" x2="15" y2="17"/>
              </svg>
              <strong>Upload Specs</strong>
              <span class="custom-pdp__spec-pill" id="spec-pill-badge">A4 · 300 DPI</span>
            </div>
            <div class="custom-pdp__spec-grid">
              <div class="custom-pdp__spec-cell">
                <span class="custom-pdp__spec-label">Selected Size</span>
                <span class="custom-pdp__spec-value" id="spec-selected-size">A4 (8.3" × 11.7")</span>
              </div>
              <div class="custom-pdp__spec-cell">
                <span class="custom-pdp__spec-label">Print Resolution</span>
                <span class="custom-pdp__spec-value" id="spec-selected-pixels">2480 × 3508 px @ 300 DPI</span>
              </div>
              <div class="custom-pdp__spec-cell">
                <span class="custom-pdp__spec-label">File types</span>
                <span class="custom-pdp__spec-value">JPG, PNG, WebP, HEIC</span>
              </div>
              <div class="custom-pdp__spec-cell">
                <span class="custom-pdp__spec-label">Max file size</span>
                <span class="custom-pdp__spec-value">25 MB</span>
              </div>
              <div class="custom-pdp__spec-cell">
                <span class="custom-pdp__spec-label">Paper Finish</span>
                <span class="custom-pdp__spec-value">300 GSM Archival Matte</span>
              </div>
              <div class="custom-pdp__spec-cell">
                <span class="custom-pdp__spec-label">Color profile</span>
                <span class="custom-pdp__spec-value">sRGB recommended</span>
              </div>
            </div>
            <div class="custom-pdp__spec-actions">
              <button type="button" class="custom-pdp__spec-link" id="open-size-guide">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                  <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                  <line x1="12" y1="22.08" x2="12" y2="12"/>
                </svg>
                View full size guide
              </button>
              <a class="custom-pdp__spec-link" href="/print/poster-specs" target="_blank" rel="noopener">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/>
                </svg>
                Size & DPI chart
              </a>
            </div>
          </div>

          <!-- CTA / Add to Cart -->
          <div class="custom-pdp__cta-wrap">
            <button type="button" class="btn btn--primary custom-pdp__main-cta" id="start-creating-btn">
              Start Creating
            </button>
            <button type="button" class="btn btn--outline custom-pdp__buy-now" id="buy-now">
              Buy It Now
            </button>
          </div>

          <!-- Delivery Badge -->
          <div class="custom-pdp__delivery-card">
            <div class="custom-pdp__delivery-head">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="1" y="3" width="15" height="13"/>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                <circle cx="5.5" cy="18.5" r="2.5"/>
                <circle cx="18.5" cy="18.5" r="2.5"/>
              </svg>
              <strong>Fast Dispatch (24–48 Hours)</strong>
            </div>
            <p>Every product is custom-printed to order with care. Printed on ultra-thick 300 GSM archival matte paper with anti-glare coating.</p>
          </div>

          <!-- Accordions -->
          <details class="pdp__accordion" open>
            <summary>Template & Upload Guidelines</summary>
            <div class="pdp__description body-text">
              <p><strong>A4 Size:</strong> 2480 × 3508 px @ 300 DPI</p>
              <p><strong>A5 Size:</strong> 1748 × 2480 px @ 300 DPI</p>
              <p><strong>Square Size:</strong> 2550 × 2550 px @ 300 DPI</p>
              <p>For custom designer templates, provide PNG-24 with a transparent cutout window for the photo placeholder. sRGB color profile recommended.</p>
            </div>
          </details>

          <details class="pdp__accordion">
            <summary>Product Description & Quality</summary>
            <div class="pdp__description body-text">
              {(product.description || '').split('\n\n').map((para: string) => (
                <p>{para}</p>
              ))}
            </div>
          </details>

          <details class="pdp__accordion">
            <summary>Shipping & Returns</summary>
            <div class="pdp__description body-text">
              <p><strong>Free Express Shipping:</strong> Available on all prepaid orders (3–4 days transit time).</p>
              <p><strong>Secure Packaging:</strong> Ships flat or in heavy-duty triangular kraft tubes with corner guards to prevent creasing.</p>
            </div>
          </details>
        </div>
      </div>
    ) : (
      /* ─── STANDARD POSTER PDP ─── */
      <div class="pdp__grid">
        <div class="pdp__gallery">
          <div class="pdp__main-image">
            <img id="main-image" src={defaultMainImage} alt={product.title} width="360" height="504" />
          </div>
          {images.length > 0 && (
            <div class="pdp__thumbs" role="tablist" aria-label="Product images">
              {images.map((img: string, i: number) => (
                <button type="button" class={`pdp__thumb ${i === 0 ? 'pdp__thumb--active' : ''}`} data-image={img} aria-label={`View image ${i + 1}`}>
                  <img src={img} alt="" width="80" height="112" loading="lazy" />
                </button>
              ))}
            </div>
          )}
        </div>

        <div class="pdp__info">
          <div class="pdp__reviews">
            <span class="pdp__rating">4.9</span>
            <span class="pdp__reviews-sep" aria-hidden="true">·</span>
            <span class="pdp__reviews-count">1,000+ reviews</span>
          </div>

          <h1 class="pdp__title heading-serif">{product.title}</h1>

          <div class="pdp__price-block">
            <span class="pdp__price" id="display-price">{formatPrice(product.variants[0]?.price || product.minPrice)}</span>
            {product.onSale && product.variants[0]?.compareAtPrice && (
              <span class="pdp__compare-price" id="compare-price">{formatPrice(product.variants[0].compareAtPrice)}</span>
            )}
            {product.onSale && <span class="pdp__sale-badge">Sale</span>}
          </div>

          <p class="pdp__tax-note">Taxes included. Shipping calculated at checkout.</p>

          <div class="pdp__variant">
            <label class="label">Size</label>
            <div class="pdp__size-options" id="size-options">
              {product.variants.map((v, i) => (
                <button
                  class={`pdp__size-btn ${i === 0 ? 'pdp__size-btn--active' : ''}`}
                  data-size={v.size}
                  data-price={v.price}
                  data-compare={v.compareAtPrice || ''}
                  data-variant-id={v.id}
                >
                  {v.size}
                </button>
              ))}
            </div>
          </div>

          <details class="pdp__offers">
            <summary class="pdp__offers-summary">
              <span class="label">Bundle savings</span>
              <span class="pdp__offers-lead">Mix any designs — applied at checkout</span>
            </summary>
            <ul class="pdp__offers-list">
              {comboOffers.map((offer) => (
                <li class="pdp__offer">
                  <div class="pdp__offer-main">
                    <span class="pdp__offer-tier">{offer.tier}</span>
                    <span class="pdp__offer-rate">{offer.rate}</span>
                  </div>
                  <span class="pdp__offer-detail">{offer.detail}</span>
                </li>
              ))}
            </ul>
          </details>

          <div class="pdp__actions">
            <div class="pdp__qty">
              <button type="button" id="qty-minus" aria-label="Decrease quantity">−</button>
              <input type="number" id="qty-input" value="1" min="1" max="99" aria-label="Quantity" />
              <button type="button" id="qty-plus" aria-label="Increase quantity">+</button>
            </div>
            <button type="button" class="btn btn--maroon pdp__add-cart" id="add-to-cart">
              Add to cart
            </button>
          </div>
          <button type="button" class="btn btn--outline pdp__buy-now" id="buy-now">
            Buy it now
          </button>

          <details class="pdp__accordion">
            <summary>Product Description +</summary>
            <div class="pdp__description body-text">
              {(product.description || '').split('\n\n').map((para: string) => (
                <p>{para}</p>
              ))}
            </div>
          </details>

          <details class="pdp__accordion">
            <summary>Shipping & Processing</summary>
            <div class="pdp__description body-text">
              <p><strong>Free Express Shipping</strong> for all prepaid orders (3-4 days transit).</p>
              <p>Standard shipping for COD orders (7-8 days transit).</p>
              <p>Print-on-demand — 1-2 business days processing time.</p>
            </div>
          </details>
        </div>
      </div>
    )}

    {related.length > 0 && (
      <section class="pdp__related">
        <h2 class="heading-serif">You may also like</h2>
        <div class="pdp__related-grid">
          {related.map((p) => <ProductCard product={p} />)}
        </div>
      </section>
    )}
  </main>

  <!-- Size Guide Modal (customizer only) -->
  {isCustom && (
    <div class="size-guide-modal" id="size-guide-modal" role="dialog" aria-modal="true" aria-labelledby="size-guide-title" hidden>
      <div class="size-guide-modal__backdrop" data-close-modal></div>
      <div class="size-guide-modal__panel" role="document">
        <div class="size-guide-modal__head">
          <h2 id="size-guide-title" class="size-guide-modal__title">Size & Upload Guide</h2>
          <button type="button" class="size-guide-modal__close" data-close-modal aria-label="Close size guide">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
          </button>
        </div>
        <div class="size-guide-modal__body">
          <p class="size-guide-modal__intro">All sizes are printed on ultra-thick 300 GSM archival matte paper with anti-glare coating, at <strong>300 DPI</strong> for crisp, gallery-quality output.</p>

          <div class="size-guide-modal__visual" aria-hidden="true">
            <div class="size-bar size-bar--a5" data-label="A5">
              <span class="size-bar__dim">5.8 × 8.3"</span>
              <span class="size-bar__px">1748 × 2480 px</span>
            </div>
            <div class="size-bar size-bar--a4" data-label="A4">
              <span class="size-bar__dim">8.3 × 11.7"</span>
              <span class="size-bar__px">2480 × 3508 px</span>
            </div>
            <div class="size-bar size-bar--square" data-label="Square">
              <span class="size-bar__dim">8.5 × 8.5"</span>
              <span class="size-bar__px">2550 × 2550 px</span>
            </div>
            <div class="size-bar size-bar--a3" data-label="A3">
              <span class="size-bar__dim">11.7 × 16.5"</span>
              <span class="size-bar__px">3510 × 4950 px</span>
            </div>
          </div>

          <table class="size-guide-modal__table">
            <thead>
              <tr><th>Size</th><th>Inches</th><th>Pixels @ 300 DPI</th><th>Best for</th></tr>
            </thead>
            <tbody>
              <tr><td><strong>A5</strong></td><td>5.8 × 8.3"</td><td>1748 × 2480 px</td><td>Desk, shelf, small gift</td></tr>
              <tr><td><strong>A4</strong></td><td>8.3 × 11.7"</td><td>2480 × 3508 px</td><td>Standard wall poster</td></tr>
              <tr><td><strong>Square</strong></td><td>8.5 × 8.5"</td><td>2550 × 2550 px</td><td>Instagram prints, frames</td></tr>
              <tr><td><strong>A3</strong></td><td>11.7 × 16.5"</td><td>3510 × 4950 px</td><td>Statement wall piece</td></tr>
            </tbody>
          </table>

          <div class="size-guide-modal__upload">
            <h3 class="size-guide-modal__h3">How to prep your file</h3>
            <ul class="size-guide-modal__list">
              <li><strong>Format:</strong> JPG, PNG, WebP, or HEIC. PNG-24 for templates with a transparent cutout window.</li>
