    cursor: pointer;
    transition: all 0.15s ease;
  }

  .size-guide-modal__btn:hover { border-color: #1a1a1a; }

  .size-guide-modal__btn--primary {
    background: #8b1a10;
    border-color: #8b1a10;
    color: #fff;
  }

  .size-guide-modal__btn--primary:hover {
    background: #6f140c;
    border-color: #6f140c;
  }

  @media (max-width: 480px) {
    .size-guide-modal__visual { gap: 0.35rem; }
    .size-bar--a3 { height: 140px; }
    .size-bar--a4 { height: 110px; }
    .size-bar--a5 { height: 75px; }
    .size-bar--square { width: 90px; height: 90px; }
    .size-guide-modal__table { font-size: 0.74rem; }
    .size-guide-modal__table th, .size-guide-modal__table td { padding: 0.4rem 0.35rem; }
  }

  /* CTAs */
  .custom-pdp__cta-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-top: 0.5rem;
  }

  .custom-pdp__main-cta {
    width: 100%;
    padding: 1.05rem;
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: #1a1a1a;
    color: #fff;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
    border: none;
    display: grid;
    place-items: center;
  }

  .custom-pdp__main-cta:hover {
    background: #8b1a10;
  }

  .custom-pdp__buy-now {
    width: 100%;
    padding: 0.85rem;
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border: 1.5px solid #1a1a1a;
    color: #1a1a1a;
    border-radius: 8px;
  }

  .custom-pdp__buy-now:hover {
    background: #1a1a1a;
    color: #fff;
  }

  .custom-pdp__delivery-card {
    background: #f9f6f0;
    border: 1px solid #e7decb;
    border-radius: 8px;
    padding: 0.85rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .custom-pdp__delivery-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #8b1a10;
    font-size: 0.82rem;
  }

  .custom-pdp__delivery-card p {
    font-size: 0.75rem;
    opacity: 0.75;
    line-height: 1.45;
    margin: 0;
  }

  /* ─── STANDARD PDP STYLES ─── */
  .pdp__grid {
    display: grid;
    grid-template-columns: minmax(0, 360px) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .pdp__gallery { max-width: 360px; }

  .pdp__main-image {
    background: #f0ebe0;
    border-radius: 4px;
    overflow: hidden;
    aspect-ratio: 5/7;
    max-height: 420px;
  }

  .pdp__main-image img { width: 100%; height: 100%; object-fit: cover; }

  .pdp__thumbs {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.75rem;
    overflow-x: auto;
    padding-bottom: 0.25rem;
    scrollbar-width: thin;
  }

  .pdp__thumb {
    flex-shrink: 0;
    width: 60px;
    height: 84px;
    border: 2px solid transparent;
    border-radius: 4px;
    overflow: hidden;
    cursor: pointer;
    padding: 0;
  }

  .pdp__thumb--active { border-color: var(--maroon); }
  .pdp__thumb img { width: 100%; height: 100%; object-fit: cover; }

  .pdp__reviews {
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    margin-bottom: 0.65rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    opacity: 0.72;
  }

  .pdp__rating { font-weight: 600; color: var(--maroon); }
  .pdp__reviews-sep { opacity: 0.45; }
  .pdp__reviews-count { font-weight: 400; }

  .pdp__title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: 1rem;
    line-height: 1.2;
  }

  .pdp__price-block {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
  }

  .pdp__price { font-size: 1.35rem; font-weight: 700; }
  .pdp__compare-price { text-decoration: line-through; opacity: 0.5; font-size: 1rem; }

  .pdp__sale-badge {
    background: var(--maroon);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    text-transform: uppercase;
  }

  .pdp__tax-note {
    font-size: 0.8rem;
    opacity: 0.65;
    margin-bottom: 1.5rem;
  }

  .pdp__variant { margin-bottom: 1.5rem; }
  .pdp__variant .label { display: block; margin-bottom: 0.5rem; }

  .pdp__size-options { display: flex; flex-wrap: wrap; gap: 0.5rem; }

  .pdp__size-btn {
    padding: 0.55rem 1.1rem;
    border: 1.5px solid var(--maroon);
    border-radius: var(--radius-btn);
    font-size: 0.85rem;
    font-weight: 500;
    background: transparent;
    color: var(--maroon);
    transition: all var(--transition);
  }

  .pdp__size-btn--active,
  .pdp__size-btn:hover {
    background: var(--maroon);
    color: var(--cream);
  }

  .pdp__offers {
    position: relative;
    margin-bottom: 1.35rem;
    padding: 1.15rem 1.5rem 0 0;
    border-top: 1px solid var(--cream-dark);
  }

  .pdp__offers-summary {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    cursor: pointer;
    list-style: none;
    padding-bottom: 0.15rem;
  }

  .pdp__offers-summary::-webkit-details-marker { display: none; }

  .pdp__offers-summary::after {
    content: '+';
    position: absolute;
    right: 0;
    top: 1.15rem;
    font-family: var(--serif);
    font-size: 1.1rem;
    font-weight: 400;
    opacity: 0.45;
    line-height: 1;
  }

  .pdp__offers[open] .pdp__offers-summary::after { content: '−'; }

  .pdp__offers-lead {
    font-family: var(--serif);
    font-size: 0.92rem;
    font-style: italic;
    opacity: 0.82;
    line-height: 1.35;
  }

  .pdp__offers-list {
    margin-top: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .pdp__offer {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid rgba(139, 26, 16, 0.07);
  }

  .pdp__offer:last-child { border-bottom: none; padding-bottom: 0; }

  .pdp__offer-main {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .pdp__offer-tier { font-size: 0.8rem; font-weight: 500; letter-spacing: 0.01em; }
  .pdp__offer-rate { font-size: 0.75rem; font-weight: 600; color: var(--maroon); white-space: nowrap; }
  .pdp__offer-detail { font-size: 0.7rem; opacity: 0.55; line-height: 1.35; }

  .pdp__actions { display: flex; gap: 0.75rem; margin-bottom: 1.5rem; }

  .pdp__qty {
    display: flex;
    align-items: center;
    border: 1.5px solid var(--maroon);
    border-radius: var(--radius-btn);
    overflow: hidden;
  }

  .pdp__qty button {
    width: 40px;
    height: 44px;
    font-size: 1.1rem;
    color: var(--maroon);
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .pdp__qty input {
    width: 48px;
    text-align: center;
    border: none;
    font-size: 0.9rem;
    font-family: inherit;
    background: transparent;
    -moz-appearance: textfield;
  }

  .pdp__qty input::-webkit-outer-spin-button,
  .pdp__qty input::-webkit-inner-spin-button { -webkit-appearance: none; }

  .pdp__add-cart {
    flex: 1;
    padding: 0.85rem 1.5rem;
    font-size: 0.9rem;
  }

  .pdp__buy-now {
    width: 100%;
    padding: 0.85rem 1.5rem;
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
    border: 1.5px solid var(--maroon);
    background: transparent;
    color: var(--maroon);
    border-radius: var(--radius-btn);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    transition: all var(--transition);
  }

  .pdp__buy-now:hover { background: var(--maroon); color: var(--cream); }

  .pdp__accordion {
    border-top: 1px solid var(--cream-dark);
    padding: 1rem 0;
  }

  .pdp__accordion summary {
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    list-style: none;
  }

  .pdp__accordion summary::-webkit-details-marker { display: none; }

  .pdp__description {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .pdp__description p { margin-bottom: 0.75rem; }

  .pdp__related {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid var(--cream-dark);
  }

  .pdp__related h2 {
    font-size: 1.75rem;
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .pdp__related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .custom-pdp {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .custom-pdp__stage {
      flex-direction: column-reverse;
      position: static;
    }

    .custom-pdp__thumbs {
      flex-direction: row;
      overflow-x: auto;
      padding-bottom: 0.5rem;
    }
  }

  @media (max-width: 768px) {
    .pdp__grid { grid-template-columns: 1fr; }
    .pdp__actions { flex-direction: column; }
    .pdp__qty {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script define:vars={{ productId: product.id, productTitle: product.title, productSlug: product.slug, productImage: defaultMainImage, isCustomProduct: isCustom }}>
  let customUploadedUrl = null;
  let customUploadedFile = null;
  let selectedColor = 'Cream White';
  let selectedFormat = 'Square';

  function getActiveSizeBtn() {
    return document.querySelector('.custom-size-pill--active, .pdp__size-btn--active');
  }

  function getLineItem() {
    const activeBtn = getActiveSizeBtn();
    const qtyInput = document.getElementById('qty-input');
    const qty = qtyInput ? parseInt(qtyInput.value) : 1;

    const formatSelect = document.getElementById('format-select');
    const format = formatSelect ? formatSelect.value : selectedFormat;

    return {
      productId,
      title: productTitle,
      slug: productSlug,
      image: customUploadedUrl || productImage,
      customImage: customUploadedUrl || null,
      format,
      color: selectedColor,
      size: activeBtn?.dataset.size || 'A4',
      variantId: activeBtn?.dataset.variantId || '',
      price: parseInt(activeBtn?.dataset.price || '7900'),
      quantity: qty,
    };
  }

  const SIZE_INFO = {
    'A4': { inches: '8.3" × 11.7"', mm: '210 × 297 mm', pixels: '2480 × 3508 px', desc: 'Standard wall poster' },
    'A5': { inches: '5.8" × 8.3"', mm: '148 × 210 mm', pixels: '1748 × 2480 px', desc: 'Desk, shelf, compact gift' },
    'Square': { inches: '8.5" × 8.5"', mm: '216 × 216 mm', pixels: '2550 × 2550 px', desc: 'Square frames & Instagram memories' },
    'A3': { inches: '11.7" × 16.5"', mm: '297 × 420 mm', pixels: '3508 × 4960 px', desc: 'Large statement wall piece' },
  };

  function updateSizeDimensions(size) {
    const info = SIZE_INFO[size] || {
      inches: 'Custom Dimensions',
      mm: 'Standard Print',
      pixels: '300 DPI High-Res',
      desc: 'Gallery-grade archival print',
    };

    const dimName = document.getElementById('selected-dim-name');
    const dimVal = document.getElementById('selected-dim-val');
    const dimPx = document.getElementById('selected-dim-px');
    const dimDesc = document.getElementById('selected-dim-desc');
    const uploadTitle = document.getElementById('upload-status-title');
    const uploadDesc = document.getElementById('upload-status-desc');
    const specPill = document.getElementById('spec-pill-badge');
    const specSize = document.getElementById('spec-selected-size');
    const specPx = document.getElementById('spec-selected-pixels');

    if (dimName) dimName.textContent = size;
    if (dimVal) dimVal.textContent = `${info.inches} (${info.mm})`;
    if (dimPx) dimPx.textContent = `Print Resolution: ${info.pixels} @ 300 DPI`;
    if (dimDesc) dimDesc.textContent = info.desc;

    if (uploadTitle) uploadTitle.textContent = `Upload your photo for ${size} (${info.inches}) print`;
    if (uploadDesc) uploadDesc.textContent = `Recommended: ${info.pixels} @ 300 DPI (JPG, PNG, HEIC up to 25MB)`;

    if (specPill) specPill.textContent = `${size} · 300 DPI`;
    if (specSize) specSize.textContent = `${size} (${info.inches})`;
    if (specPx) specPx.textContent = `${info.pixels} @ 300 DPI`;
  }

  // Size pill clicking
  const sizeBtns = document.querySelectorAll('.custom-size-pill, .pdp__size-btn');
  const displayPrice = document.getElementById('display-price');
  const comparePrice = document.getElementById('compare-price');

  sizeBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      sizeBtns.forEach((b) => {
        b.classList.remove('custom-size-pill--active', 'pdp__size-btn--active');
      });
      btn.classList.add(btn.classList.contains('custom-size-pill') ? 'custom-size-pill--active' : 'pdp__size-btn--active');

      const size = btn.dataset.size || 'A4';
      updateSizeDimensions(size);

      const price = parseInt(btn.dataset.price || '0');
      if (displayPrice) displayPrice.textContent = `₹${(price / 100).toFixed(2)}`;
      if (comparePrice && btn.dataset.compare) {
        comparePrice.textContent = `₹${(parseInt(btn.dataset.compare) / 100).toFixed(2)}`;
        comparePrice.style.display = '';
      } else if (comparePrice) {
        comparePrice.style.display = 'none';
      }
    });
  });

  // Initial dimensions sync on page load
  const initialActiveBtn = document.querySelector('.custom-size-pill--active');
  if (initialActiveBtn && initialActiveBtn.dataset.size) {
    updateSizeDimensions(initialActiveBtn.dataset.size);
  }

  // Sync format dropdown if changed
  const formatSelect = document.getElementById('format-select');
  if (formatSelect) {
    formatSelect.addEventListener('change', (e) => {
      const val = e.target.value;
      if (val === 'Square') {
        const sqBtn = Array.from(sizeBtns).find((b) => b.dataset.size === 'Square');
        if (sqBtn) sqBtn.click();
      } else if (val.includes('A4')) {
        const a4Btn = Array.from(sizeBtns).find((b) => b.dataset.size === 'A4');
        if (a4Btn) a4Btn.click();
      }
    });
  }

  // Customizer: Color swatch clicking
  const swatches = document.querySelectorAll('.custom-swatch');
  const mockupCanvas = document.getElementById('mockup-canvas');
  const selectedColorName = document.getElementById('selected-color-name');

  swatches.forEach((swatch) => {
    swatch.addEventListener('click', () => {
      swatches.forEach((s) => s.classList.remove('custom-swatch--active'));
      swatch.classList.add('custom-swatch--active');
      const theme = swatch.dataset.theme || 'cream';
      selectedColor = swatch.dataset.colorName || 'Cream White';
      if (mockupCanvas) mockupCanvas.setAttribute('data-theme', theme);
      if (selectedColorName) selectedColorName.textContent = selectedColor;
    });
  });

  // Customizer: Thumbnails switching
  document.querySelectorAll('.custom-pdp__thumb').forEach((thumb) => {
    thumb.addEventListener('click', () => {
      const src = thumb.dataset.thumbSrc;
      const mockupImg = document.getElementById('mockup-photo');
      if (mockupImg && src) mockupImg.src = src;
      document.querySelectorAll('.custom-pdp__thumb').forEach((t) => t.classList.remove('custom-pdp__thumb--active'));
      thumb.classList.add('custom-pdp__thumb--active');
    });
  });

  // Standard PDP Thumbs
  document.querySelectorAll('.pdp__thumb').forEach((thumb) => {
    thumb.addEventListener('click', () => {
      const mainImg = document.getElementById('main-image');
      if (mainImg) mainImg.src = thumb.dataset.image;
      document.querySelectorAll('.pdp__thumb').forEach((t) => t.classList.remove('pdp__thumb--active'));
      thumb.classList.add('pdp__thumb--active');
    });
  });

  // Photo Upload Handling
  const fileInput = document.getElementById('custom-file-input');
  const triggerBtn = document.getElementById('trigger-upload-btn');
  const dropzone = document.getElementById('upload-dropzone');
  const previewBar = document.getElementById('upload-preview-bar');
  const previewThumb = document.getElementById('upload-preview-thumb');
  const filenameLabel = document.getElementById('upload-filename');
  const removePhotoBtn = document.getElementById('remove-uploaded-photo');
  const mockupPhoto = document.getElementById('mockup-photo');

  if (triggerBtn && fileInput) {
    triggerBtn.addEventListener('click', () => fileInput.click());
  }

  async function uploadFileToServer(file) {
    const formData = new FormData();
    formData.append('file', file);
    const res = await fetch('/api/upload', {
      method: 'POST',
      body: formData,
    });
    if (!res.ok) throw new Error('Failed to upload image');
    const data = await res.json();
    return data.url;
  }

  function handleFileSelected(file) {
    if (!file) return;
    customUploadedFile = file;
    const reader = new FileReader();
    reader.onload = (e) => {
      const dataUrl = e.target.result;
      if (mockupPhoto) mockupPhoto.src = dataUrl;
      if (previewThumb) previewThumb.src = dataUrl;
      if (filenameLabel) filenameLabel.textContent = file.name;
      if (dropzone) dropzone.style.display = 'none';
      if (previewBar) {
        previewBar.style.display = 'flex';
        previewBar.removeAttribute('hidden');
      }
    };
    reader.readAsDataURL(file);

    // Upload in background
    uploadFileToServer(file)
      .then((url) => {
        customUploadedUrl = url;
      })
      .catch((err) => {
        console.error('Upload error:', err);
      });
  }

  if (fileInput) {
    fileInput.addEventListener('change', (e) => {
      const file = e.target.files?.[0];
      handleFileSelected(file);
    });
  }

  if (dropzone) {
    dropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.style.borderColor = '#1a1a1a';
    });
    dropzone.addEventListener('dragleave', () => {
      dropzone.style.borderColor = '';
    });
    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.style.borderColor = '';
      const file = e.dataTransfer?.files?.[0];
      handleFileSelected(file);
    });
  }

  if (removePhotoBtn) {
    removePhotoBtn.addEventListener('click', () => {
      customUploadedUrl = null;
      customUploadedFile = null;
      if (fileInput) fileInput.value = '';
      if (mockupPhoto) mockupPhoto.src = productImage;
      if (previewBar) {
        previewBar.style.display = 'none';
        previewBar.setAttribute('hidden', '');
      }
      if (dropzone) dropzone.style.display = 'flex';
    });
  }

  // Add to cart & Start Creating
  async function handleAddToCart(redirectCheckout = false) {
    const btn = document.getElementById('start-creating-btn') || document.getElementById('add-to-cart');
    const originalText = btn ? btn.textContent : 'Add to cart';

    if (btn) {
      btn.textContent = 'Preparing...';
      btn.disabled = true;
    }

    if (customUploadedFile && !customUploadedUrl) {
      try {
        customUploadedUrl = await uploadFileToServer(customUploadedFile);
      } catch {
        // Fallback to client preview
      }
    }

    const item = getLineItem();
    window.TWCart.addToCart(item);

    if (btn) {
      btn.textContent = 'Added ✓';
      btn.style.background = '#2d6a4f';
      setTimeout(() => {
        btn.textContent = originalText;
        btn.style.background = '';
        btn.disabled = false;
      }, 2000);
    }

    if (redirectCheckout) {
      window.location.href = '/checkout';
    }
  }

  document.getElementById('start-creating-btn')?.addEventListener('click', () => handleAddToCart(false));
  document.getElementById('add-to-cart')?.addEventListener('click', () => handleAddToCart(false));

  document.getElementById('buy-now')?.addEventListener('click', () => handleAddToCart(true));

  // Quantity handlers
  document.getElementById('qty-minus')?.addEventListener('click', () => {
    const qtyInput = document.getElementById('qty-input');
    if (qtyInput) qtyInput.value = String(Math.max(1, parseInt(qtyInput.value) - 1));
  });
  document.getElementById('qty-plus')?.addEventListener('click', () => {
    const qtyInput = document.getElementById('qty-input');
    if (qtyInput) qtyInput.value = String(Math.min(99, parseInt(qtyInput.value) + 1));
  });

  // Size Guide Modal (customizer PDP)
  const sizeGuideModal = document.getElementById('size-guide-modal');
  if (sizeGuideModal) {
    const openModal = () => {
      sizeGuideModal.removeAttribute('hidden');
      document.body.style.overflow = 'hidden';
      const closeBtn = sizeGuideModal.querySelector('.size-guide-modal__close');
      if (closeBtn) setTimeout(() => closeBtn.focus(), 50);
    };
    const closeModal = () => {
      sizeGuideModal.setAttribute('hidden', '');
      document.body.style.overflow = '';
    };

    document.getElementById('view-size-guide')?.addEventListener('click', (e) => {
      e.preventDefault();
      openModal();
    });
    document.getElementById('view-size-guide')?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openModal();
      }
    });
    document.getElementById('open-size-guide')?.addEventListener('click', (e) => {
      e.preventDefault();
      openModal();
    });

    sizeGuideModal.querySelectorAll('[data-close-modal]').forEach((el) => {
      el.addEventListener('click', closeModal);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !sizeGuideModal.hasAttribute('hidden')) {
        closeModal();
      }
    });
  }
</script>
