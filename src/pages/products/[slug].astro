</style>

<script define:vars={{ productId: product.id, productTitle: product.title, productSlug: product.slug, productImage: defaultMainImage, isCustomProduct: isCustom }}>
  let customUploadedUrl = null;
  let customUploadedFile = null;
  let selectedColor = 'Cream White';
  let selectedFormat = 'Square';

  function getActiveSizeBtn() {
    return document.querySelector('.custom-size-pill--active, .pdp__size-btn--active');
  }

  function getLineItem() {
    const activeBtn = getActiveSizeBtn();
    const qtyInput = document.getElementById('qty-input');
    const qty = qtyInput ? parseInt(qtyInput.value) : 1;

    const formatSelect = document.getElementById('format-select');
    const format = formatSelect ? formatSelect.value : selectedFormat;

    return {
      productId,
      title: productTitle,
      slug: productSlug,
      image: customUploadedUrl || productImage,
      customImage: customUploadedUrl || null,
      format,
      color: selectedColor,
      size: activeBtn?.dataset.size || 'A4',
      variantId: activeBtn?.dataset.variantId || '',
      price: parseInt(activeBtn?.dataset.price || '7900'),
      quantity: qty,
    };
  }

  // Size pill clicking
  const sizeBtns = document.querySelectorAll('.custom-size-pill, .pdp__size-btn');
  const displayPrice = document.getElementById('display-price');
  const comparePrice = document.getElementById('compare-price');

  sizeBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      sizeBtns.forEach((b) => {
        b.classList.remove('custom-size-pill--active', 'pdp__size-btn--active');
      });
      btn.classList.add(btn.classList.contains('custom-size-pill') ? 'custom-size-pill--active' : 'pdp__size-btn--active');

      const price = parseInt(btn.dataset.price || '0');
      if (displayPrice) displayPrice.textContent = `₹${(price / 100).toFixed(2)}`;
      if (comparePrice && btn.dataset.compare) {
        comparePrice.textContent = `₹${(parseInt(btn.dataset.compare) / 100).toFixed(2)}`;
        comparePrice.style.display = '';
      } else if (comparePrice) {
        comparePrice.style.display = 'none';
      }
    });
  });

  // Customizer: Color swatch clicking
  const swatches = document.querySelectorAll('.custom-swatch');
  const mockupCanvas = document.getElementById('mockup-canvas');
  const selectedColorName = document.getElementById('selected-color-name');

  swatches.forEach((swatch) => {
    swatch.addEventListener('click', () => {
      swatches.forEach((s) => s.classList.remove('custom-swatch--active'));
      swatch.classList.add('custom-swatch--active');
      const theme = swatch.dataset.theme || 'cream';
      selectedColor = swatch.dataset.colorName || 'Cream White';
      if (mockupCanvas) mockupCanvas.setAttribute('data-theme', theme);
      if (selectedColorName) selectedColorName.textContent = selectedColor;
    });
  });

  // Customizer: Thumbnails switching
  document.querySelectorAll('.custom-pdp__thumb').forEach((thumb) => {
    thumb.addEventListener('click', () => {
      const src = thumb.dataset.thumbSrc;
      const mockupImg = document.getElementById('mockup-photo');
      if (mockupImg && src) mockupImg.src = src;
      document.querySelectorAll('.custom-pdp__thumb').forEach((t) => t.classList.remove('custom-pdp__thumb--active'));
      thumb.classList.add('custom-pdp__thumb--active');
    });
  });

  // Standard PDP Thumbs
  document.querySelectorAll('.pdp__thumb').forEach((thumb) => {
    thumb.addEventListener('click', () => {
      const mainImg = document.getElementById('main-image');
      if (mainImg) mainImg.src = thumb.dataset.image;
      document.querySelectorAll('.pdp__thumb').forEach((t) => t.classList.remove('pdp__thumb--active'));
      thumb.classList.add('pdp__thumb--active');
    });
  });

  // Photo Upload Handling
  const fileInput = document.getElementById('custom-file-input');
  const triggerBtn = document.getElementById('trigger-upload-btn');
  const dropzone = document.getElementById('upload-dropzone');
  const previewBar = document.getElementById('upload-preview-bar');
  const previewThumb = document.getElementById('upload-preview-thumb');
  const filenameLabel = document.getElementById('upload-filename');
  const removePhotoBtn = document.getElementById('remove-uploaded-photo');
  const mockupPhoto = document.getElementById('mockup-photo');

  if (triggerBtn && fileInput) {
    triggerBtn.addEventListener('click', () => fileInput.click());
  }

  async function uploadFileToServer(file) {
    const formData = new FormData();
    formData.append('file', file);
    const res = await fetch('/api/upload', {
      method: 'POST',
      body: formData,
    });
    if (!res.ok) throw new Error('Failed to upload image');
    const data = await res.json();
    return data.url;
  }

  function handleFileSelected(file) {
    if (!file) return;
    customUploadedFile = file;
    const reader = new FileReader();
    reader.onload = (e) => {
      const dataUrl = e.target.result;
      if (mockupPhoto) mockupPhoto.src = dataUrl;
      if (previewThumb) previewThumb.src = dataUrl;
      if (filenameLabel) filenameLabel.textContent = file.name;
      if (dropzone) dropzone.style.display = 'none';
      if (previewBar) {
        previewBar.style.display = 'flex';
        previewBar.removeAttribute('hidden');
      }
    };
    reader.readAsDataURL(file);

    // Upload in background
    uploadFileToServer(file)
      .then((url) => {
        customUploadedUrl = url;
      })
      .catch((err) => {
        console.error('Upload error:', err);
      });
  }

  if (fileInput) {
    fileInput.addEventListener('change', (e) => {
      const file = e.target.files?.[0];
      handleFileSelected(file);
    });
  }

  if (dropzone) {
    dropzone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropzone.style.borderColor = '#1a1a1a';
    });
    dropzone.addEventListener('dragleave', () => {
      dropzone.style.borderColor = '';
    });
    dropzone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropzone.style.borderColor = '';
      const file = e.dataTransfer?.files?.[0];
      handleFileSelected(file);
    });
  }

  if (removePhotoBtn) {
    removePhotoBtn.addEventListener('click', () => {
      customUploadedUrl = null;
      customUploadedFile = null;
      if (fileInput) fileInput.value = '';
      if (mockupPhoto) mockupPhoto.src = productImage;
      if (previewBar) {
        previewBar.style.display = 'none';
        previewBar.setAttribute('hidden', '');
      }
      if (dropzone) dropzone.style.display = 'flex';
    });
  }

  // Add to cart & Start Creating
  async function handleAddToCart(redirectCheckout = false) {
    const btn = document.getElementById('start-creating-btn') || document.getElementById('add-to-cart');
    const originalText = btn ? btn.textContent : 'Add to cart';

    if (btn) {
      btn.textContent = 'Preparing...';
      btn.disabled = true;
    }

    if (customUploadedFile && !customUploadedUrl) {
      try {
        customUploadedUrl = await uploadFileToServer(customUploadedFile);
      } catch {
        // Fallback to client preview
      }
    }

    const item = getLineItem();
    window.TWCart.addToCart(item);

    if (btn) {
      btn.textContent = 'Added ✓';
      btn.style.background = '#2d6a4f';
      setTimeout(() => {
        btn.textContent = originalText;
        btn.style.background = '';
        btn.disabled = false;
      }, 2000);
    }

    if (redirectCheckout) {
      window.location.href = '/checkout';
    }
  }

  document.getElementById('start-creating-btn')?.addEventListener('click', () => handleAddToCart(false));
  document.getElementById('add-to-cart')?.addEventListener('click', () => handleAddToCart(false));

  document.getElementById('buy-now')?.addEventListener('click', () => handleAddToCart(true));

  // Quantity handlers
  document.getElementById('qty-minus')?.addEventListener('click', () => {
    const qtyInput = document.getElementById('qty-input');
    if (qtyInput) qtyInput.value = String(Math.max(1, parseInt(qtyInput.value) - 1));
  });
  document.getElementById('qty-plus')?.addEventListener('click', () => {
    const qtyInput = document.getElementById('qty-input');
    if (qtyInput) qtyInput.value = String(Math.min(99, parseInt(qtyInput.value) + 1));
  });
</script>
