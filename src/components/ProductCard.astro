---
import type { ProductWithVariants } from '../lib/products';
import { parseImages } from '../lib/products';
import { formatPrice } from '../lib/db';

interface Props {
  product: ProductWithVariants;
}
const { product } = Astro.props;
const images = parseImages(product.images);
const defaultVariant = product.variants[0];
---

<article class="product-card">
  <a href={`/products/${product.slug}`} class="product-card__link">
    <div class="product-card__image-wrap">
      {product.onSale && <span class="product-card__badge">Sale</span>}
      <img
        src={images[0] || '/logo.png'}
        alt={product.title}
        class="product-card__image"
        loading="lazy"
        width="400"
        height="560"
      />
    </div>
    <h3 class="product-card__title">{product.title}</h3>
    <div class="product-card__price">
      <span class="product-card__price-current">From {formatPrice(product.minPrice)}</span>
      {product.onSale && defaultVariant?.compareAtPrice && (
        <span class="product-card__price-compare">{formatPrice(defaultVariant.compareAtPrice)}</span>
      )}
    </div>
  </a>
</article>

<style>
  .product-card__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .product-card__image-wrap {
    position: relative;
    aspect-ratio: 5/7;
    overflow: hidden;
    border-radius: 4px;
    background: #f0ebe0;
    margin-bottom: 0.75rem;
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .product-card:hover .product-card__image {
    transform: scale(1.03);
  }

  .product-card__badge {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    background: var(--maroon);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
    z-index: 1;
  }

  .product-card__title {
    font-family: var(--serif);
    font-size: 0.9rem;
    font-weight: 500;
    line-height: 1.35;
    margin-bottom: 0.35rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-card__price {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
  }

  .product-card__price-current {
    font-weight: 600;
  }

  .product-card__price-compare {
    text-decoration: line-through;
    opacity: 0.5;
    font-size: 0.8rem;
  }
</style>
