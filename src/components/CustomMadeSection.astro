---
const products = [
  {
    num: '01',
    title: 'Memory Posters',
    description: 'Custom timeless posters with live photo preview.',
    image: '/images/custom-made/memory-poster.png',
    href: '/products/best-sister-timeless',
  },
  {
    num: '02',
    title: 'Custom Albums',
    description: 'Design your own album that tells your story.',
    image: '/images/custom-made/album.png',
    href: '/products/memory-poster',
  },
  {
    num: '03',
    title: 'Framed Wall Art',
    description: 'Gallery-grade framed prints for any space.',
    image: '/images/custom-made/framed-wall-art.jpg',
    href: '/shop',
  },
  {
    num: '04',
    title: 'Polaroids & Keepsakes',
    description: 'Classic instant-style prints for your wall.',
    image: '/images/custom-made/polaroids.png',
    href: '/shop',
  },
] as const;
---

<section class="custom-made section section--cream" id="custom-made" aria-labelledby="custom-made-heading">
  <div class="container custom-made__inner">
    <div class="custom-made__intro">
      <span class="label custom-made__label">Custom Made</span>
      <h2 id="custom-made-heading" class="heading-serif custom-made__title">
        YOUR MEMORIES.<br />YOUR WAY.
      </h2>
      <div class="custom-made__accent" aria-hidden="true">
        <span class="custom-made__line" />
        <svg class="custom-made__heart" width="18" height="16" viewBox="0 0 18 16" fill="none">
          <path
            d="M9 15.5C9 15.5 1 10.2 1 5.4C1 3.1 2.8 1.3 5.1 1.3C6.6 1.3 8 2.1 9 3.4C10 2.1 11.4 1.3 12.9 1.3C15.2 1.3 17 3.1 17 5.4C17 10.2 9 15.5 9 15.5Z"
            fill="currentColor"
          />
        </svg>
      </div>
      <p class="body-text custom-made__text">
        Personalized keepsakes made just for you. Upload, customize and we'll handle the rest.
      </p>
      <a href="/shop" class="btn btn--maroon custom-made__cta">Create Yours <span aria-hidden="true">→</span></a>
    </div>

    <div class="custom-made__grid">
      {
        products.map((product) => (
          <article class="custom-made__card">
            <header class="custom-made__card-head">
              <span class="custom-made__num">{product.num}</span>
              <h3 class="custom-made__card-title">{product.title}</h3>
              <p class="custom-made__card-desc">{product.description}</p>
            </header>

            <div class="custom-made__visual">
              <img
                src={product.image}
                alt={product.title}
                loading="lazy"
                width="320"
                height="280"
              />
            </div>

            <div class="custom-made__card-foot">
              <a href={product.href} class="btn btn--maroon custom-made__card-btn">
                Customize Now <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .custom-made {
    position: relative;
    padding-block: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .custom-made__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 2.25fr);
    gap: clamp(1.75rem, 3.5vw, 3rem);
    align-items: start;
  }

  .custom-made__intro {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 0.5rem;
    position: sticky;
    top: calc(var(--nav-h) + 1rem);
  }

  .custom-made__label {
    color: var(--maroon);
    opacity: 0.9;
  }

  .custom-made__title {
    color: var(--maroon);
    font-size: clamp(2rem, 3.6vw, 2.85rem);
    line-height: 1.08;
  }

  .custom-made__accent {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--maroon);
    margin-top: -0.25rem;
  }

  .custom-made__line {
    display: block;
    width: 2.5rem;
    height: 1px;
    background: currentColor;
    opacity: 0.55;
  }

  .custom-made__heart {
    opacity: 0.85;
  }

  .custom-made__text {
    color: var(--maroon);
    opacity: 0.82;
    max-width: 30ch;
  }

  .custom-made__cta {
    align-self: flex-start;
    margin-top: 0.5rem;
  }

  .custom-made__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.85rem, 1.8vw, 1.25rem);
    min-width: 0;
    align-items: stretch;
  }

  .custom-made__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 0;
    padding: 0;
    border: 1px solid rgba(139, 26, 16, 0.14);
    border-radius: 10px;
    background: transparent;
    min-width: 0;
    transition: border-color var(--transition);
  }

  .custom-made__card:hover {
    border-color: rgba(139, 26, 16, 0.28);
  }

  .custom-made__card-head {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: clamp(0.85rem, 1.4vw, 1.1rem) clamp(0.85rem, 1.4vw, 1.1rem) 0;
  }

  .custom-made__num {
    font-family: var(--serif);
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    font-weight: 500;
    line-height: 1;
    color: var(--maroon);
    opacity: 0.35;
  }

  .custom-made__card-title {
    font-family: var(--sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--maroon);
    line-height: 1.3;
  }

  .custom-made__card-desc {
    font-size: 0.72rem;
    line-height: 1.45;
    color: var(--maroon);
    opacity: 0.72;
    min-height: 2.15em;
  }

  .custom-made__visual {
    flex: 1 1 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: clamp(130px, 14vw, 170px);
    padding-inline: clamp(0.4rem, 1vw, 0.7rem);
    line-height: 0;
  }

  .custom-made__visual img {
    width: 100%;
    max-height: clamp(120px, 13vw, 160px);
    height: auto;
    object-fit: contain;
    object-position: center;
  }

  .custom-made__card-foot {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.5rem clamp(0.85rem, 1.4vw, 1.1rem) clamp(0.85rem, 1.4vw, 1.1rem);
  }

  .custom-made__upload {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-inline: 0;
    padding: 0.7rem 0.75rem;
    border: 1.5px dashed rgba(139, 26, 16, 0.28);
    border-radius: 8px;
    color: var(--maroon);
    background: transparent;
    transition: border-color var(--transition);
  }

  .custom-made__upload:hover {
    border-color: rgba(139, 26, 16, 0.45);
  }

  .custom-made__upload-text {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }

  .custom-made__upload-text strong {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .custom-made__upload-text small {
    font-size: 0.62rem;
    opacity: 0.65;
    letter-spacing: 0.02em;
  }

  .custom-made__card-btn {
    width: 100%;
    margin: 0;
    justify-content: center;
    padding: 0.75rem 0.5rem;
    font-size: 0.65rem;
  }

  @media (max-width: 1100px) {
    .custom-made__inner {
      grid-template-columns: 1fr;
    }

    .custom-made__intro {
      position: static;
      text-align: center;
      align-items: center;
    }

    .custom-made__text {
      max-width: 42ch;
    }

    .custom-made__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .custom-made__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.55rem;
    }

    .custom-made__cta {
      width: 100%;
      justify-content: center;
    }

    .custom-made__card-head {
      padding: 0.55rem 0.55rem 0;
      gap: 0.2rem;
    }

    .custom-made__num {
      font-size: 1.35rem;
    }

    .custom-made__card-title {
      font-size: 0.58rem;
      letter-spacing: 0.08em;
    }

    .custom-made__card-desc {
      font-size: 0.62rem;
      min-height: 2.4em;
      line-height: 1.35;
    }

    .custom-made__visual {
      min-height: 72px;
      padding-inline: 0.3rem;
    }

    .custom-made__visual img {
      max-height: 68px;
    }

    .custom-made__card-foot {
      padding: 0.35rem 0.5rem 0.5rem;
      gap: 0.35rem;
    }

    .custom-made__upload {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 0.45rem 0.35rem;
      gap: 0.3rem;
    }

    .custom-made__upload :global(svg) {
      width: 18px;
      height: 18px;
    }

    .custom-made__upload-text strong {
      font-size: 0.52rem;
      line-height: 1.25;
    }

    .custom-made__upload-text small {
      display: none;
    }

    .custom-made__card-btn {
      padding: 0.55rem 0.25rem;
      font-size: 0.55rem;
      letter-spacing: 0.08em;
    }
  }
</style>
