---
const currentYear = new Date().getFullYear();
---

<footer class="footer section--maroon">
  <div class="container footer__inner">
    <div class="footer__brand">
      <a href="/" class="footer__logo-link" aria-label="the.Wall home">
        <img
          src="/logo.png"
          alt="the.Wall — your personal archive"
          class="footer__logo-img"
          width="163"
          height="45"
          loading="lazy"
          decoding="async"
        />
      </a>
      <p class="footer__tagline">A place where memories become wall-worthy.</p>
      <p class="footer__mission">
        The Wall Records preserves <strong>MEMORIES.</strong> Whether it's a favorite movie, a travel destination, a special person, or a moment that changed someone's life — we help people turn memories into something they can see every day.
      </p>
    </div>

    <div class="footer__columns">
      <div class="footer__col">
        <h4>Memories</h4>
        <ul>
          <li><a href="/#custom-made">Memory Albums</a></li>
          <li><a href="/#custom-made">Photo Books</a></li>
          <li><a href="/#custom-made">Wedding Albums</a></li>
          <li><a href="/#custom-made">Family Albums</a></li>
        </ul>
      </div>
      <div class="footer__col">
        <h4>Posters</h4>
        <ul>
          <li><a href="/collections/movies">Cinema</a></li>
          <li><a href="/collections/aesthetic">Photography</a></li>
          <li><a href="/collections/motivation-quotes">Quotes</a></li>
          <li><a href="/collections/aesthetic">Aesthetic</a></li>
        </ul>
      </div>
      <div class="footer__col">
        <h4>Custom Made</h4>
        <ul>
          <li><a href="/products/best-sister-timeless">Best Sister Poster</a></li>
          <li><a href="/products/memory-poster">Memory Posters</a></li>
          <li><a href="/products/memory-poster">Custom Albums</a></li>
          <li><a href="/shop">All Posters</a></li>
        </ul>
      </div>
      <div class="footer__col">
        <h4>Company</h4>
        <ul>
          <li><a href="/shop">Shop</a></li>
          <li><a href="/search">Search</a></li>
          <li><a href="/contact">Contact</a></li>
          <li><a href="/policies/about">About Us</a></li>
        </ul>
      </div>
      <div class="footer__col">
        <h4>Policies</h4>
        <ul>
          <li><a href="/policies/privacy">Privacy Policy</a></li>
          <li><a href="/policies/terms">Terms & Conditions</a></li>
          <li><a href="/policies/refund">Refund Policy</a></li>
          <li><a href="/policies/shipping">Shipping Policy</a></li>
          <li><a href="/policies/faq">FAQ</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer__bottom container">
    <p>&copy; {currentYear} The Wall Records. All rights reserved.</p>
    <p class="footer__credit">
      Made by
      <a href="https://adelev8.com" target="_blank" rel="noopener noreferrer">Adelev8</a>
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid rgba(245, 241, 230, 0.1);
    padding-top: clamp(3rem, 6vw, 5rem);
    color: var(--cream);
  }

  .footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1.8fr);
    gap: clamp(2rem, 5vw, 4rem);
    padding-bottom: 3rem;
    min-width: 0;
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .footer__logo-link {
    display: inline-block;
    align-self: flex-start;
  }

  .footer__logo-img {
    display: block;
    height: clamp(36px, 5vw, 44px);
    width: auto;
    border-radius: 2px;
  }

  .footer__tagline {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--cream);
    font-style: italic;
    max-width: 32ch;
    opacity: 0.95;
  }

  .footer__mission {
    font-size: 0.85rem;
    line-height: 1.65;
    color: var(--cream);
    opacity: 0.82;
    max-width: 42ch;
  }

  .footer__mission strong {
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .footer__columns {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1.25rem;
    min-width: 0;
  }

  .footer__col h4 {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cream);
    margin-bottom: 1rem;
  }

  .footer__col a {
    display: block;
    font-size: 0.82rem;
    color: var(--cream);
    opacity: 0.75;
    padding: 0.25rem 0;
    transition: opacity var(--transition);
  }

  .footer__col a:hover {
    opacity: 1;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.5rem 2.5rem;
    border-top: 1px solid rgba(245, 241, 230, 0.12);
    font-size: 0.75rem;
    color: var(--cream);
    opacity: 0.7;
  }

  .footer__credit a {
    color: var(--cream);
    opacity: 1;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
    transition: opacity var(--transition);
  }

  .footer__credit a:hover {
    opacity: 0.85;
  }

  @media (max-width: 900px) {
    .footer__inner {
      grid-template-columns: 1fr;
    }

    .footer__columns {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer__mission {
      max-width: none;
    }
  }

  @media (max-width: 600px) {
    .footer__columns {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
