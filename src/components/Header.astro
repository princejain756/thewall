---
import { navigation, getMegaPreviewImages, previewId } from '../data/navigation';

interface Props {
  searchPage?: boolean;
  initialQuery?: string;
}

const { searchPage = false, initialQuery = '' } = Astro.props;
---

<header class:list={['nav', { 'nav--search-page': searchPage }]} data-header>
  <div
    class="nav__search-suite"
    {...(!searchPage && {
      'data-predictive-search': true,
      'data-predictive-limit': '6',
      'data-predictive-variant': 'compact',
    })}
  >
  <div class="nav__bar">
    <div class="nav__inner container">
      <a href="/" class="nav__logo" aria-label="the.Wall home">
        <img
          src="/logo.png"
          alt="the.Wall — your personal archive"
          class="nav__logo-img"
          width="163"
          height="45"
          decoding="async"
        />
      </a>

      <nav class="nav__menu" aria-label="Main navigation">
        <ul class="nav__list" role="menubar">
          {
            navigation.map((item, index) => (
              <li
                class="nav__item"
                role="none"
                data-nav-item={item.id}
                data-nav-type={item.type}
                data-nav-variant={item.variant ?? 'standard'}
              >
                {item.type === 'link' ? (
                  <a
                    href={item.href}
                    class="nav__trigger nav__trigger--link"
                    role="menuitem"
                    data-index={String(index).padStart(2, '0')}
                  >
                    <span class="nav__trigger-text">{item.label}</span>
                    <span class="nav__trigger-line" aria-hidden="true" />
                  </a>
                ) : (
                  <button
                    type="button"
                    class="nav__trigger"
                    role="menuitem"
                    aria-haspopup="true"
                    aria-expanded="false"
                    data-nav-trigger
                    data-index={String(index).padStart(2, '0')}
                  >
                    <span class="nav__trigger-text">{item.label}</span>
                    <span class="nav__trigger-line" aria-hidden="true" />
                    {item.type === 'mega' ? (
                      <svg class="nav__trigger-icon" width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
                        <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    ) : (
                      <svg class="nav__trigger-icon nav__trigger-icon--sm" width="6" height="6" viewBox="0 0 6 6" fill="none" aria-hidden="true">
                        <circle cx="3" cy="3" r="1.2" fill="currentColor" />
                      </svg>
                    )}
                  </button>
                )}

                {item.type === 'mega' && item.groups && item.variant === 'cinematic' && (
                  <div class="nav__panel nav__panel--cinematic" data-nav-panel hidden>
                    <div class="nav__panel-bridge" aria-hidden="true" />
                    <div class="nav__cinematic" data-mega-panel={item.id}>
                      <div class="nav__cinematic-media" aria-hidden="true">
                        {
                          getMegaPreviewImages(item).map((preview, pi) => (
                            <img
                              class:list={['nav__cinematic-img', { 'is-active': preview.id === 'default' }]}
                              src={preview.src}
                              alt=""
                              data-mega-img={preview.id}
                              data-mega-label={preview.label}
                              loading="lazy"
                              width="1400"
                              height="800"
                              style={`--pi: ${pi}`}
                            />
                          ))
                        }
                        <div class="nav__cinematic-scrim" />
                        <div class="nav__cinematic-vignette" />
                      </div>

                      <div class="nav__cinematic-body container">
                        <div class="nav__cinematic-editorial">
                          {item.eyebrow && <span class="nav__eyebrow nav__eyebrow--light">{item.eyebrow}</span>}
                          {item.headline && <h3 class="nav__cinematic-head serif">{item.headline}</h3>}
                          {item.description && <p class="nav__cinematic-desc">{item.description}</p>}
                          {item.cta && (
                            <a href={item.cta.href} class="nav__cinematic-cta btn btn--cream">
                              {item.cta.label} <span aria-hidden="true">→</span>
                            </a>
                          )}
                          <p class="nav__cinematic-preview serif" data-mega-caption>
                            {item.headline}
                          </p>
                        </div>

                        <div class="nav__cinematic-groups">
                          {
                            item.groups.map((group, gi) => (
                              <div class="nav__group nav__group--cinematic" style={`--gi: ${gi}`}>
                                <h4 class="nav__group-title nav__group-title--light">{group.title}</h4>
                                <ul class="nav__group-list">
                                  {
                                    group.links.map((link, li) => (
                                      <li style={`--li: ${li}`}>
                                        <a
                                          href={link.href}
                                          class="nav__group-link nav__group-link--light"
                                          data-preview-image={previewId(link.label)}
                                          data-preview-label={link.label}
                                        >
                                          <span class="nav__group-link-text">{link.label}</span>
                                          <span class="nav__group-link-arrow" aria-hidden="true">→</span>
                                        </a>
                                      </li>
                                    ))
                                  }
                                </ul>
                              </div>
                            ))
                          }
                        </div>
                      </div>
                    </div>
                  </div>
                )}

                {item.type === 'mega' && item.groups && item.variant !== 'cinematic' && (
                  <div class="nav__panel nav__panel--mega" data-nav-panel hidden>
                    <div class="nav__panel-bridge" aria-hidden="true" />
                    <div class="nav__panel-inner container" data-mega-panel={item.id}>
                      <aside class="nav__panel-editorial">
                        <div class="nav__panel-visual">
                          {
                            getMegaPreviewImages(item).map((preview) => (
                              <img
                                class:list={['nav__preview-img', { 'is-active': preview.id === 'default' }]}
                                src={preview.src}
                                alt=""
                                data-mega-img={preview.id}
                                data-mega-label={preview.label}
                                loading="lazy"
                                width="320"
                                height="400"
                              />
                            ))
                          }
                          <div class="nav__panel-visual-frame" aria-hidden="true" />
                          <p class="nav__preview-caption serif" data-mega-caption>{item.headline}</p>
                        </div>
                        <div class="nav__panel-copy">
                          {item.eyebrow && <span class="nav__eyebrow">{item.eyebrow}</span>}
                          {item.headline && <h3 class="nav__panel-head serif">{item.headline}</h3>}
                          {item.description && <p class="nav__panel-desc">{item.description}</p>}
                          {item.cta && (
                            <a href={item.cta.href} class="nav__panel-cta">
                              {item.cta.label}
                              <span aria-hidden="true">→</span>
                            </a>
                          )}
                        </div>
                      </aside>

                      <div class="nav__panel-groups" style={`--group-count: ${item.groups.length}`}>
                        {
                          item.groups.map((group, gi) => (
                            <div class="nav__group" style={`--gi: ${gi}`}>
                              <h4 class="nav__group-title">{group.title}</h4>
                              <ul class="nav__group-list">
                                {
                                  group.links.map((link, li) => (
                                    <li style={`--li: ${li}`}>
                                      <a
                                        href={link.href}
                                        class="nav__group-link"
                                        data-preview-image={link.image ? previewId(link.label) : undefined}
                                        data-preview-label={link.label}
                                      >
                                        <span class="nav__group-link-text">{link.label}</span>
                                        <span class="nav__group-link-arrow" aria-hidden="true">→</span>
                                      </a>
                                    </li>
                                  ))
                                }
                              </ul>
                            </div>
                          ))
                        }
                      </div>
                    </div>
                  </div>
                )}

                {item.type === 'dropdown' && item.links && (
                  <div class="nav__panel nav__panel--dropdown" data-nav-panel hidden>
                    <div class="nav__panel-bridge" aria-hidden="true" />
                    <div class="nav__dropdown-card">
                      <ul class="nav__dropdown-list">
                        {
                          item.links.map((link, li) => (
                            <li style={`--li: ${li}`}>
                              <a href={link.href} class="nav__dropdown-link">
                                <span class="nav__dropdown-link-main">{link.label}</span>
                                {link.description && (
                                  <span class="nav__dropdown-link-sub">{link.description}</span>
                                )}
                              </a>
                            </li>
                          ))
                        }
                      </ul>
                    </div>
                  </div>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <button type="button" class="nav__search" data-search-open aria-label="Search products" aria-expanded="false">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.5"/>
          <path d="M20 20L16.5 16.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>

      <a href="/account" class="nav__account" aria-label="My account">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.5"/>
          <path d="M5 20c0-3.5 3.1-6 7-6s7 2.5 7 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </a>

      <a href="/cart" class="nav__cart" aria-label="Shopping cart">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6h15l-1.5 9h-12L6 6z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          <path d="M6 6L5 3H2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="9.5" cy="19.5" r="1.5" fill="currentColor"/>
          <circle cx="16.5" cy="19.5" r="1.5" fill="currentColor"/>
        </svg>
        <span class="nav__cart-count" data-cart-count>0</span>
      </a>

      <button
        type="button"
        class="nav__burger"
        aria-label="Open menu"
        aria-expanded="false"
        data-nav-burger
      >
        <span class="nav__burger-lines" aria-hidden="true">
          <span></span>
          <span></span>
        </span>
        <span class="nav__burger-label">Menu</span>
      </button>
    </div>

    <div class="nav__search-strip">
      <form class="nav__search-form" method="get" action="/search" role="search" data-search-form>
        <label class="nav__search-field">
          <span class="nav__search-leading" aria-hidden="true">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none">
              <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.5"/>
              <path d="M20 20L16.5 16.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </span>
          <span class="visually-hidden">Search products</span>
          <input
            type="search"
            name="q"
            placeholder="Search posters..."
            class="nav__search-input"
            data-search-input
            {...(!searchPage && { 'data-predictive-input': true })}
            value={initialQuery}
            autocomplete="off"
            enterkeyhint="search"
          />
          <button type="button" class="nav__search-clear" data-predictive-clear hidden aria-label="Clear search">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M6 6L18 18M18 6L6 18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </button>
        </label>
      </form>
    </div>
  </div>

  <div class="nav__search-dropdown" data-search-dropdown hidden>
    <div class="nav__search-dropdown-inner">
      <div class="nav__search-meta" data-predictive-meta hidden>
        <p class="nav__search-meta-text">
          Found <strong data-predictive-count>0</strong> results for '<span data-predictive-query></span>'
        </p>
        <a href="/search" class="nav__search-view-all" data-predictive-view-all>View all results →</a>
      </div>
      <div class="nav__search-grid" data-predictive-grid role="list"></div>
      <p class="nav__search-empty" data-predictive-empty hidden>No results found. Try another keyword.</p>
      <p class="nav__search-loading" data-predictive-loading hidden>Searching...</p>
    </div>
  </div>
  </div>

  <div class="nav__backdrop" data-nav-backdrop hidden aria-hidden="true" />

  <div class="nav__mobile" data-nav-mobile hidden>
    <div class="nav__mobile-head">
      <span class="nav__mobile-eyebrow">Navigate</span>
      <button type="button" class="nav__mobile-close" aria-label="Close menu" data-nav-close>
        <span></span>
        <span></span>
      </button>
    </div>
    <div class="nav__mobile-body">
      {
        navigation.map((item, i) => (
          item.type === 'link' ? (
            <a href={item.href} class="nav__mobile-link" style={`--i: ${i}`}>
              <span class="nav__mobile-index">{String(i + 1).padStart(2, '0')}</span>
              <span class="nav__mobile-label serif">{item.label}</span>
            </a>
          ) : (
            <details class="nav__mobile-item" style={`--i: ${i}`}>
              <summary class="nav__mobile-summary">
                <span class="nav__mobile-index">{String(i + 1).padStart(2, '0')}</span>
                <span class="nav__mobile-label serif">{item.label}</span>
                <span class="nav__mobile-chevron" aria-hidden="true" />
              </summary>
              <div class="nav__mobile-panel">
                {item.type === 'mega' && item.groups ? (
                  item.groups.map((group) => (
                    <div class="nav__mobile-group">
                      <span class="nav__mobile-group-title">{group.title}</span>
                      <ul>
                        {group.links.map((link) => (
                          <li>
                            <a href={link.href}>{link.label}</a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))
                ) : (
                  <ul class="nav__mobile-flat">
                    {item.links?.map((link) => (
                      <li>
                        <a href={link.href}>{link.label}</a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </details>
          )
        ))
      }
    </div>
    <div class="nav__mobile-foot">
      <p class="nav__mobile-tagline serif">A place where memories become wall-worthy.</p>
      <a href="/#custom-made" class="nav__mobile-cta">Create Your Design →</a>
    </div>
  </div>
</header>

<style>
  .nav {
    --nav-bar-h: 68px;
    --nav-search-h: 0px;
    --nav-h: var(--nav-bar-h);
    --panel-ease: cubic-bezier(0.22, 1, 0.36, 1);
    position: sticky;
    top: 0;
    z-index: 200;
    width: 100%;
    overflow-x: clip;
  }

  @media (max-width: 1120px) {
    .nav {
      --nav-search-h: 44px;
      --nav-h: calc(var(--nav-bar-h) + var(--nav-search-h));
    }
  }

  .nav__bar {
    position: relative;
    z-index: 202;
    background: var(--maroon);
    color: var(--cream);
    border-bottom: 1px solid rgba(245, 241, 230, 0.06);
    transition: background 0.4s var(--panel-ease), box-shadow 0.4s var(--panel-ease);
  }

  .nav.is-scrolled .nav__bar {
    background: rgba(139, 26, 16, 0.94);
    backdrop-filter: blur(16px) saturate(1.2);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
    box-shadow: 0 1px 0 rgba(245, 241, 230, 0.05), 0 12px 40px rgba(0, 0, 0, 0.18);
  }

  .nav.is-open .nav__bar {
    background: var(--maroon);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: var(--nav-bar-h);
    width: 100%;
    max-width: 100%;
  }

  .nav__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    z-index: 1;
  }

  .nav__logo-img {
    display: block;
    height: clamp(32px, 4.5vw, 40px);
    width: auto;
    max-width: min(160px, 42vw);
    mix-blend-mode: screen;
    transition: opacity 0.3s ease;
  }

  .nav__logo:hover .nav__logo-img {
    opacity: 0.88;
  }

  .nav__menu {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .nav__trigger--link {
    text-decoration: none;
    color: inherit;
  }

  .nav__search {
    display: flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    opacity: 0.9;
    transition: opacity 0.2s ease;
    padding: 0.35rem;
    flex-shrink: 0;
  }

  .nav__search:hover {
    opacity: 1;
  }

  .nav__search-suite {
    position: relative;
  }

  .nav--search-page .nav__search-dropdown {
    display: none !important;
  }

  .nav__search-panel {
    display: none;
  }

  .nav__search-strip {
    display: none;
    padding: 0 var(--section-pad-x) 0.4rem;
    background: var(--maroon);
  }

  .nav__search-form {
    width: 100%;
  }

  .nav__search-field {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    background: #fff;
    border: none;
    border-radius: 999px;
    padding: 0 0.75rem;
    min-height: 36px;
    width: 100%;
  }

  .nav__search-leading {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--maroon);
    opacity: 0.42;
  }

  .nav__search-input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    font: inherit;
    font-size: 0.84rem;
    color: var(--maroon);
    padding: 0.45rem 0;
  }

  .nav__search-input::placeholder {
    color: rgba(139, 26, 16, 0.38);
  }

  .nav__search-input:focus {
    outline: none;
  }

  .nav__search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  .nav__search-clear {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    color: var(--maroon);
    opacity: 0.4;
    transition: opacity 0.2s ease;
  }

  .nav__search-clear:hover {
    opacity: 0.75;
  }

  .nav__search-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 201;
    background: var(--cream);
    border-bottom: 1px solid rgba(139, 26, 16, 0.08);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.07);
    max-height: min(50vh, 360px);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .nav__search-dropdown[hidden] {
    display: none !important;
  }

  .nav__search-dropdown-inner {
    padding: 0.5rem var(--section-pad-x) 0.65rem;
  }

  .nav__search-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0 0 0.45rem;
    margin-bottom: 0.45rem;
    border-bottom: 1px solid rgba(139, 26, 16, 0.08);
  }

  .nav__search-meta[hidden],
  .nav__search-empty[hidden],
  .nav__search-loading[hidden] {
    display: none !important;
  }

  .nav__search-meta-text {
    font-size: 0.7rem;
    opacity: 0.75;
    min-width: 0;
  }

  .nav__search-meta-text strong {
    font-weight: 700;
    color: var(--maroon);
  }

  .nav__search-view-all {
    flex-shrink: 0;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--maroon);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav__search-view-all:hover {
    text-decoration: underline;
  }

  .nav__search-grid {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .nav__search-empty,
  .nav__search-loading {
    font-size: 0.75rem;
    opacity: 0.65;
    padding: 0.75rem 0;
    text-align: center;
  }

  @media (max-width: 1120px) {
    .nav__search-strip {
      display: block;
    }

    .nav__search {
      display: none;
    }

    .nav__search-dropdown {
      max-height: min(38vh, 280px);
    }
  }

  @media (min-width: 1121px) {
    .nav.is-search-active .nav__search-strip {
      display: block;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      padding: 0.65rem var(--section-pad-x);
      background: var(--cream);
      border-bottom: 1px solid rgba(139, 26, 16, 0.08);
      z-index: 3;
    }

    .nav__search-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 0.85rem 0.75rem;
    }

    .nav__search-dropdown {
      max-height: min(55vh, 420px);
    }

    .nav__search-dropdown-inner {
      padding: 0.65rem var(--section-pad-x) 0.85rem;
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .nav__account {
    display: flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    opacity: 0.9;
    transition: opacity 0.2s ease;
    padding: 0.35rem;
  }

  .nav__account:hover {
    opacity: 1;
  }

  .nav__cart {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--cream);
    flex-shrink: 0;
    margin-right: 0.25rem;
    transition: opacity var(--transition);
  }

  .nav__cart:hover {
    opacity: 0.85;
  }

  .nav__cart-count {
    position: absolute;
    top: 2px;
    right: 2px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    background: var(--cream);
    color: var(--maroon);
    font-size: 0.6rem;
    font-weight: 700;
    border-radius: 8px;
    display: none;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .nav__cart-count.is-visible {
    display: flex;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: clamp(0.15rem, 1.2vw, 0.35rem);
  }

  .nav__item {
    position: relative;
  }

  .nav__trigger {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem clamp(0.55rem, 1.1vw, 0.85rem);
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: rgba(245, 241, 230, 0.88);
    white-space: nowrap;
    transition: color 0.3s ease;
  }

  .nav__trigger::before {
    content: attr(data-index);
    position: absolute;
