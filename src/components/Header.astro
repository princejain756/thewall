  const burger = document.querySelector('[data-nav-burger]');
  const closeBtn = document.querySelector('[data-nav-close]');
  const searchOpenBtn = document.querySelector('[data-search-open]');
  const searchDropdown = document.querySelector('[data-search-dropdown]');
  const searchForm = document.querySelector('[data-search-form]');
  const searchInput = document.querySelector('[data-search-input]') as HTMLInputElement | null;
  const items = document.querySelectorAll('[data-nav-item]');

  let activeItem: Element | null = null;
  let closeTimer: ReturnType<typeof setTimeout> | null = null;

  const isDesktop = () => window.matchMedia('(min-width: 1121px)').matches;

  const closeAll = () => {
    items.forEach((item) => {
      item.classList.remove('is-active');
      const trigger = item.querySelector('[data-nav-trigger]');
      const panel = item.querySelector('[data-nav-panel]');
      trigger?.setAttribute('aria-expanded', 'false');
      panel?.setAttribute('hidden', '');
      resetMegaPreview(item);
    });
    header?.classList.remove('is-open', 'is-cinematic-open');
    backdrop?.setAttribute('hidden', '');
    activeItem = null;
  };

  const resetMegaPreview = (scope: ParentNode) => {
    scope.querySelectorAll('[data-mega-panel]').forEach((panel) => {
      panel.querySelectorAll('[data-mega-img]').forEach((img) => {
        img.classList.toggle('is-active', img.getAttribute('data-mega-img') === 'default');
      });
      const caption = panel.querySelector('[data-mega-caption]');
      const defaultImg = panel.querySelector('[data-mega-img="default"]') as HTMLElement | null;
      if (caption && defaultImg?.dataset.megaLabel) {
        caption.textContent = defaultImg.dataset.megaLabel;
      }
      panel.querySelector('.nav__panel-visual')?.classList.remove('is-previewing');
    });
    scope.querySelectorAll('[data-preview-image].is-preview-active').forEach((el) => {
      el.classList.remove('is-preview-active');
    });
  };

  const setMegaPreview = (panel: Element, previewId: string, label: string) => {
    panel.querySelectorAll('[data-mega-img]').forEach((img) => {
      img.classList.toggle('is-active', img.getAttribute('data-mega-img') === previewId);
    });
    const caption = panel.querySelector('[data-mega-caption]');
    if (caption) caption.textContent = label;
    panel.querySelector('.nav__panel-visual')?.classList.add('is-previewing');
  };

  document.querySelectorAll('[data-mega-panel]').forEach((panel) => {
    panel.querySelectorAll('[data-preview-image]').forEach((link) => {
      link.addEventListener('mouseenter', () => {
        const previewId = link.getAttribute('data-preview-image');
        const label = link.getAttribute('data-preview-label');
        if (!previewId || !label) return;

        panel.querySelectorAll('[data-preview-image]').forEach((l) => l.classList.remove('is-preview-active'));
        link.classList.add('is-preview-active');
        setMegaPreview(panel, previewId, label);
      });
    });

    panel.addEventListener('mouseleave', () => resetMegaPreview(panel));
  });

  const openItem = (item: Element) => {
    if (!isDesktop()) return;
    closeAll();
    item.classList.add('is-active');
    const trigger = item.querySelector('[data-nav-trigger]');
    const panel = item.querySelector('[data-nav-panel]');
    trigger?.setAttribute('aria-expanded', 'true');
    panel?.removeAttribute('hidden');
    header?.classList.add('is-open');
    if (item.getAttribute('data-nav-variant') === 'cinematic') {
      header?.classList.add('is-cinematic-open');
    }
    backdrop?.removeAttribute('hidden');
    activeItem = item;
  };

  items.forEach((item) => {
    const trigger = item.querySelector('[data-nav-trigger]');

    item.addEventListener('mouseenter', () => {
      if (!isDesktop()) return;
      if (closeTimer) clearTimeout(closeTimer);
      openItem(item);
    });

    item.addEventListener('mouseleave', () => {
      if (!isDesktop()) return;
      closeTimer = setTimeout(closeAll, 120);
    });

    trigger?.addEventListener('click', (e) => {
      if (!isDesktop()) return;
      e.preventDefault();
      if (item.classList.contains('is-active')) {
        closeAll();
      } else {
        openItem(item);
      }
    });

    trigger?.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAll();
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        if (item.classList.contains('is-active')) closeAll();
        else openItem(item);
      }
    });
  });

  backdrop?.addEventListener('click', closeAll);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeAll();
      closeMobile();
      closeSearch();
    }
  });

  const isMobileNav = () => window.matchMedia('(max-width: 1120px)').matches;

  const showSearchDropdown = () => {
    searchDropdown?.removeAttribute('hidden');
    header?.classList.add('is-search-active');
    searchOpenBtn?.setAttribute('aria-expanded', 'true');
  };

  const hideSearchDropdown = () => {
    searchDropdown?.setAttribute('hidden', '');
    header?.classList.remove('is-search-active');
    searchOpenBtn?.setAttribute('aria-expanded', 'false');
  };

  const clearSearchDropdown = () => {
    if (searchInput) searchInput.value = '';
    searchDropdown?.querySelector('[data-predictive-clear]')?.setAttribute('hidden', '');
    searchDropdown?.querySelector('[data-predictive-grid]')?.replaceChildren();
    searchDropdown?.querySelector('[data-predictive-meta]')?.setAttribute('hidden', '');
    searchDropdown?.querySelector('[data-predictive-empty]')?.setAttribute('hidden', '');
    searchDropdown?.querySelector('[data-predictive-loading]')?.setAttribute('hidden', '');
  };

  const closeSearch = () => {
    hideSearchDropdown();
    clearSearchDropdown();
    searchInput?.blur();
  };

  searchInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      const q = searchInput.value.trim();
      if (q && window.location.pathname !== '/search') {
        window.location.href = `/search?q=${encodeURIComponent(q)}`;
      }
    }
  });

  document.addEventListener('click', (e) => {
    if (!header?.classList.contains('is-search-active')) return;
    const target = e.target as Node;
    if (header.contains(target)) return;
    closeSearch();
  });

  searchOpenBtn?.addEventListener('click', () => {
    if (isMobileNav() || window.location.pathname === '/search') {
      searchInput?.focus();
      return;
    }
    if (header?.classList.contains('is-search-active')) {
      closeSearch();
    } else {
      closeAll();
      closeMobile();
      showSearchDropdown();
      requestAnimationFrame(() => searchInput?.focus());
    }
  });

  searchForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    const q = searchInput?.value.trim();
    if (q) window.location.href = `/search?q=${encodeURIComponent(q)}`;
  });

  const openMobile = () => {
    closeSearch();
    header?.classList.add('is-mobile-open');
    burger?.setAttribute('aria-expanded', 'true');
    mobile?.removeAttribute('hidden');
    document.body.style.overflow = 'hidden';
  };

  const closeMobile = () => {
    header?.classList.remove('is-mobile-open');
    burger?.setAttribute('aria-expanded', 'false');
    mobile?.setAttribute('hidden', '');
    document.body.style.overflow = '';
  };

  burger?.addEventListener('click', () => {
    if (header?.classList.contains('is-mobile-open')) closeMobile();
    else openMobile();
  });

  closeBtn?.addEventListener('click', closeMobile);

  mobile?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMobile);
  });

  const onScroll = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 12);
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  window.addEventListener('resize', () => {
    if (!isDesktop()) closeAll();
  });
</script>
