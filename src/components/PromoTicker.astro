---
import { promoLines } from '../data/collections';

const items = [...promoLines, ...promoLines];
---

<div class="promo-ticker" aria-hidden="true">
  <div class="promo-ticker__viewport">
    <div class="promo-ticker__track">
      {
        items.map((line) => (
          <span class="promo-ticker__item">
            <span class="promo-ticker__dot" />
            {line}
          </span>
        ))
      }
    </div>
    <div class="promo-ticker__track" aria-hidden="true">
      {
        items.map((line) => (
          <span class="promo-ticker__item">
            {line}
          </span>
        ))
      }
    </div>
  </div>
</div>

<style>
  .promo-ticker {
    background: #1a0a08;
    color: var(--cream);
    overflow: hidden;
    border-bottom: 1px solid rgba(245, 241, 230, 0.06);
    width: 100%;
    max-height: 2.25rem;
  }

  .promo-ticker__viewport {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: center;
    width: max-content;
    will-change: transform;
  }

  .promo-ticker__track {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    flex-shrink: 0;
    align-items: center;
    padding-block: 0.5rem;
  }

  .promo-ticker__item {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding-inline: 1.75rem;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0.88;
    flex-shrink: 0;
  }

  .promo-ticker__dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--cream);
    opacity: 0.45;
    flex-shrink: 0;
  }
</style>
