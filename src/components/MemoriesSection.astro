---
import { posterSrc } from '../data/collections';

const shelfImages = [
  { src: posterSrc('the wall', 'Aesthetic', 'Love.jpeg'), alt: 'Love aesthetic poster' },
  { src: posterSrc('the wall', 'Movies', 'download.jpeg'), alt: 'Movie poster print' },
  { src: posterSrc('the wall', 'Anime', 'Gojo.jpeg'), alt: 'Gojo anime poster' },
];
---

<section class="section section--maroon memories-section" id="memories">
  <div class="container split-section">
    <div class="split-section__content">
      <span class="label">Exclusively at the Wall</span>
      <h2 class="heading-serif">memories, beautifully preserved.</h2>
      <p class="body-text">
        From meaningful moments to timeless art — every piece you find here is designed to stay with you, for a lifetime.
      </p>
      <a href="/shop" class="btn btn--cream">Shop Now <span aria-hidden="true">→</span></a>
    </div>

    <div class="split-section__media memories-section__shelf" aria-hidden="true">
      <div class="shelf">
        <div class="shelf__book shelf__book--left">
          <img src={shelfImages[0].src} alt={shelfImages[0].alt} loading="lazy" width="280" height="280" />
        </div>
        <div class="shelf__book shelf__book--center">
          <img src={shelfImages[1].src} alt={shelfImages[1].alt} loading="lazy" width="160" height="160" />
        </div>
        <div class="shelf__book shelf__book--right">
          <div class="shelf__book-cover">
            <img src={shelfImages[2].src} alt={shelfImages[2].alt} loading="lazy" width="300" height="300" />
            <span class="shelf__book-text serif">these days.</span>
          </div>
        </div>
        <div class="shelf__surface"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .memories-section__shelf {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    min-height: 380px;
    padding-bottom: 1rem;
  }

  .shelf {
    position: relative;
    width: min(100%, 420px);
    height: 320px;
  }

  .shelf__book {
    position: absolute;
    bottom: 28px;
    border-radius: 4px;
    overflow: hidden;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
  }

  .shelf__book img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shelf__book--left {
    left: 0;
    width: 200px;
    height: 260px;
    transform: rotate(-4deg);
    z-index: 1;
  }

  .shelf__book--center {
    left: 50%;
    transform: translateX(-50%) rotate(2deg);
    width: 120px;
    height: 160px;
    z-index: 3;
    bottom: 40px;
  }

  .shelf__book--right {
    right: 0;
    width: 180px;
    height: 240px;
    transform: rotate(5deg);
    z-index: 2;
  }

  .shelf__book-cover {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .shelf__book-text {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    color: #fff;
    font-size: 1.1rem;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
    white-space: nowrap;
  }

  .shelf__surface {
    position: absolute;
    bottom: 0;
    left: -10%;
    right: -10%;
    height: 12px;
    background: rgba(0, 0, 0, 0.2);
    border-radius: 50%;
    filter: blur(4px);
  }

  @media (max-width: 768px) {
    .memories-section__shelf {
      min-height: 280px;
    }

    .shelf {
      height: 240px;
      transform: scale(0.85);
    }
  }
</style>
