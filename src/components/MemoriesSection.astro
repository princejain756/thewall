---
---

<section class="section section--maroon memories-section" id="memories">
  <div class="container split-section">
    <div class="split-section__content">
      <span class="label">Exclusively at the Wall</span>
      <h2 class="heading-serif">memories, beautifully preserved.</h2>
      <p class="body-text">
        From meaningful moments to timeless art — every piece you find here is designed to stay with you, for a lifetime.
      </p>
      <a href="#shop" class="btn btn--cream">Shop Now <span aria-hidden="true">→</span></a>
    </div>

    <div class="split-section__media memories-section__shelf" aria-hidden="true">
      <div class="shelf">
        <div class="shelf__book shelf__book--left">
          <img
            src="https://images.unsplash.com/photo-1516975080664-ed2fc6a32937?w=500&h=500&fit=crop&q=80"
            alt=""
            loading="lazy"
            width="280"
            height="280"
          />
        </div>
        <div class="shelf__book shelf__book--center">
          <img
            src="https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=300&h=300&fit=crop&q=80"
            alt=""
            loading="lazy"
            width="160"
            height="160"
          />
        </div>
        <div class="shelf__book shelf__book--right">
          <div class="shelf__book-cover">
            <img
              src="https://images.unsplash.com/photo-1529156069898-49953e39b3ac?w=500&h=500&fit=crop&q=80"
              alt=""
              loading="lazy"
              width="300"
              height="300"
            />
            <span class="shelf__book-text serif">these days.</span>
          </div>
        </div>
        <div class="shelf__surface"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .memories-section__shelf {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    min-height: 380px;
    padding-bottom: 1rem;
  }

  .shelf {
    position: relative;
    width: min(100%, 520px);
    max-width: 100%;
    height: 340px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 1.25rem;
    padding-bottom: 18px;
    overflow: hidden;
  }

  .shelf__surface {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    width: 100%;
    max-width: 100%;
    height: 14px;
    background: linear-gradient(180deg, #3d2318 0%, #2a1810 40%, #1a0f0a 100%);
    border-radius: 2px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
  }

  @media (max-width: 960px) {
    .memories-section__shelf {
      min-height: 280px;
      padding-bottom: 0.5rem;
      width: 100%;
      max-width: 100%;
      overflow: hidden;
    }

    .shelf {
      width: 100%;
      max-width: 360px;
      height: 280px;
      gap: 0.75rem;
    }

    .shelf__book--left {
      width: clamp(100px, 28vw, 140px);
      height: clamp(100px, 28vw, 140px);
    }

    .shelf__book--center {
      width: clamp(70px, 18vw, 90px);
      height: clamp(70px, 18vw, 90px);
    }

    .shelf__book--right {
      width: clamp(110px, 30vw, 150px);
      height: clamp(110px, 30vw, 150px);
    }

    .shelf__book-text {
      font-size: 0.75rem;
    }
  }

  .shelf__book {
    position: relative;
    z-index: 1;
    background: #1a1a1a;
    box-shadow: 4px 6px 20px rgba(0, 0, 0, 0.4), inset -2px 0 4px rgba(255, 255, 255, 0.05);
    overflow: hidden;
  }

  .shelf__book img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.3) contrast(1.08);
  }

  .shelf__book--left {
    width: clamp(140px, 22vw, 200px);
    height: clamp(140px, 22vw, 200px);
    transform: rotate(-2deg) translateY(4px);
  }

  .shelf__book--center {
    width: clamp(90px, 14vw, 120px);
    height: clamp(90px, 14vw, 120px);
    transform: translateY(8px);
    border-radius: 2px;
  }

  .shelf__book--right {
    width: clamp(150px, 24vw, 220px);
    height: clamp(150px, 24vw, 220px);
    transform: rotate(1.5deg);
  }

  .shelf__book-cover {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .shelf__book-text {
    position: absolute;
    bottom: 12%;
    left: 50%;
    transform: translateX(-50%);
    color: #fff;
    font-size: clamp(0.9rem, 2vw, 1.2rem);
    font-style: italic;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.6);
    white-space: nowrap;
  }
</style>
