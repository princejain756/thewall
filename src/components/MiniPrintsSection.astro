---
import { posterSrc } from '../data/collections';

const features = [
  { label: 'High Quality Prints', icon: 'lock' },
  { label: 'Scratch Resistant', icon: 'shield' },
  { label: 'Made To Last', icon: 'heart' },
] as const;

const fanPrints = [
  { src: posterSrc('the wall', 'Aesthetic', 'Love.jpeg'), alt: 'Floral mini print', class: 'mini-prints__print--l1' },
  { src: posterSrc('the wall', 'Anime', 'Gojo.jpeg'), alt: 'Anime mini print', class: 'mini-prints__print--l2' },
  { src: posterSrc('the wall', 'Cars', 'A Porsche.jpeg'), alt: 'Car mini print', class: 'mini-prints__print--r1' },
  { src: posterSrc('the wall', 'Aesthetic', 'universe.jpeg'), alt: 'Photo mini print', class: 'mini-prints__print--r2' },
  { src: posterSrc('the wall', 'Anime', 'Berserk.jpeg'), alt: 'Art mini print', class: 'mini-prints__print--r3' },
] as const;
---

<section class="section section--cream section--compact mini-prints" id="pocket-memories" aria-labelledby="mini-prints-heading">
  <div class="container mini-prints__layout">
    <div class="mini-prints__content">
      <span class="label">Take Your Memories Everywhere</span>
      <h2 id="mini-prints-heading" class="heading-serif mini-prints__title">
        MINI PRINTS.<br />BIG MEANING.
      </h2>
      <p class="body-text mini-prints__text">
        Custom phone case prints that carry what matters most.
      </p>

      <ul class="mini-prints__features">
        {
          features.map((feature) => (
            <li class="mini-prints__feature">
              <span class="mini-prints__feature-icon" aria-hidden="true">
                {feature.icon === 'lock' && (
                  <svg width="20" height="20" viewBox="0 0 28 28" fill="none">
                    <rect x="8" y="13" width="12" height="10" rx="1.5" stroke="currentColor" stroke-width="1.3" />
                    <path d="M11 13V10.5C11 8.57 12.57 7 14.5 7C16.43 7 18 8.57 18 10.5V13" stroke="currentColor" stroke-width="1.3" />
                  </svg>
                )}
                {feature.icon === 'shield' && (
                  <svg width="20" height="20" viewBox="0 0 28 28" fill="none">
                    <path d="M14 4L22 7.5V13.5C22 18.5 18.5 22.5 14 24C9.5 22.5 6 18.5 6 13.5V7.5L14 4Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
                    <path d="M11 14L13 16L17 12" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
                {feature.icon === 'heart' && (
                  <svg width="20" height="20" viewBox="0 0 28 28" fill="none">
                    <path d="M14 23C14 23 5 17 5 11C5 8.24 7.24 6 10 6C11.66 6 13.18 6.84 14 8.1C14.82 6.84 16.34 6 18 6C20.76 6 23 8.24 23 11C23 17 14 23 14 23Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
                  </svg>
                )}
              </span>
              <span class="mini-prints__feature-label">{feature.label}</span>
            </li>
          ))
        }
      </ul>

      <a href="/shop" class="btn btn--maroon mini-prints__cta">Shop Mini Prints <span aria-hidden="true">→</span></a>
    </div>

    <div class="mini-prints__media" aria-hidden="true">
      <div class="mini-prints__scene">
        {
          fanPrints.map((print) => (
            <img src={print.src} alt="" class:list={['mini-prints__print', print.class]} loading="lazy" width="120" height="150" />
          ))
        }
        <img
          src="/images/custom-made/phone-case.png"
          alt=""
          class="mini-prints__phone"
          loading="lazy"
          width="271"
          height="503"
        />
        <span class="mini-prints__vase" />
      </div>
    </div>
  </div>
</section>

<style>
  .mini-prints {
    border-top: 1px solid rgba(139, 26, 16, 0.06);
  }

  .mini-prints__layout {
    display: grid;
    grid-template-columns: minmax(0, 0.38fr) minmax(0, 0.62fr);
    gap: clamp(0.85rem, 1.8vw, 1.5rem);
    align-items: stretch;
  }

  .mini-prints__content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    justify-content: center;
    max-width: 19rem;
    padding-block: 0.15rem;
  }

  .mini-prints__title {
    color: var(--maroon);
    font-size: clamp(1.65rem, 2.8vw, 2.35rem);
    line-height: 1.08;
  }

  .mini-prints__text {
    color: var(--maroon);
    opacity: 0.8;
    max-width: 28ch;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .mini-prints__features {
    display: flex;
    gap: 0.75rem 1rem;
    margin-block: 0.2rem 0.15rem;
  }

  .mini-prints__feature {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    text-align: center;
    min-width: 4.25rem;
  }

  .mini-prints__feature-icon {
    color: var(--maroon);
    opacity: 0.9;
  }

  .mini-prints__feature-label {
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--maroon);
    opacity: 0.85;
    max-width: 8ch;
    line-height: 1.25;
  }

  .mini-prints__cta {
    align-self: flex-start;
    margin-top: 0.1rem;
    padding: 0.7rem 1.25rem;
    font-size: 0.68rem;
  }

  .mini-prints__media {
    display: flex;
    align-items: stretch;
    min-width: 0;
    background: linear-gradient(165deg, #ebe3d6 0%, #e0d6c8 100%);
    border-radius: 4px;
    padding: clamp(0.65rem, 1.2vw, 1rem);
    min-height: clamp(200px, 22vw, 260px);
  }

  .mini-prints__scene {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: clamp(180px, 20vw, 240px);
  }

  .mini-prints__phone {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: clamp(100px, 13vw, 138px);
    height: auto;
    z-index: 4;
    background: transparent;
    filter: drop-shadow(0 8px 20px rgba(42, 21, 18, 0.16));
  }

  .mini-prints__print {
    position: absolute;
    width: clamp(58px, 7.5vw, 82px);
    aspect-ratio: 3 / 3.75;
    object-fit: cover;
    background: #fff;
    padding: 0.15rem 0.15rem 0.45rem;
    border-radius: 2px;
    box-shadow: 0 5px 14px rgba(42, 21, 18, 0.14);
    z-index: 2;
  }

  .mini-prints__print--l1 {
    left: 6%;
    top: 14%;
    transform: rotate(-14deg);
    z-index: 1;
  }

  .mini-prints__print--l2 {
    left: 16%;
    top: 38%;
    transform: rotate(-8deg);
    z-index: 2;
  }

  .mini-prints__print--r1 {
    right: 14%;
    top: 10%;
    transform: rotate(11deg);
    z-index: 1;
  }

  .mini-prints__print--r2 {
    right: 4%;
    top: 32%;
    transform: rotate(7deg);
    z-index: 2;
  }

  .mini-prints__print--r3 {
    right: 10%;
    top: 54%;
    transform: rotate(13deg);
    z-index: 3;
  }

  .mini-prints__vase {
    position: absolute;
    right: 6%;
    bottom: 6%;
    width: clamp(22px, 2.8vw, 32px);
    height: clamp(30px, 3.8vw, 42px);
    border-radius: 50% 50% 42% 42%;
    background: linear-gradient(180deg, #f3eee6 0%, #e8e0d4 100%);
    box-shadow: 0 2px 8px rgba(42, 21, 18, 0.1);
    z-index: 1;
  }

  .mini-prints__vase::after {
    content: '';
    position: absolute;
    top: -38%;
    left: 50%;
    width: 2px;
    height: 42%;
    background: #c4a574;
    transform: translateX(-50%) rotate(8deg);
    border-radius: 1px;
  }

  @media (max-width: 900px) {
    .mini-prints__layout {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }

    .mini-prints__content {
      max-width: none;
      text-align: center;
      align-items: center;
    }

    .mini-prints__features {
      justify-content: center;
    }

    .mini-prints__cta {
      align-self: center;
      width: 100%;
      justify-content: center;
    }

    .mini-prints__media {
      min-height: 220px;
    }
  }
</style>
