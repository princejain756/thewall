---
import type { ProductWithVariants } from '../lib/products';
import ProductCard from './ProductCard.astro';

interface Props {
  products: ProductWithVariants[];
}

const { products } = Astro.props;
---

<section class="section section--cream art-posters" id="art-posters">
  <div class="art-posters__layout">
    <div class="art-posters__content">
      <span class="label">Art Posters</span>
      <h1 class="heading-serif">prints that speak.</h1>
      <p class="body-text">Curated designs. Timeless expression.</p>
      <a href="/shop" class="btn btn--maroon">Shop Now <span aria-hidden="true">→</span></a>
    </div>

    <div class="art-posters__carousel-col">
      <button class="carousel-arrow carousel-arrow--prev" aria-label="Previous posters" data-carousel-prev>
        <svg width="14" height="24" viewBox="0 0 14 24" fill="none" aria-hidden="true">
          <path d="M12 2L2 12L12 22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>

      <div class="art-posters__carousel-wrap" data-carousel-wrap>
        <div class="art-posters__carousel" data-carousel>
          {products.map((product) => (
            <div class="art-posters__card-wrap">
              <ProductCard product={product} />
            </div>
          ))}
        </div>
      </div>

      <button class="carousel-arrow carousel-arrow--next" aria-label="Next posters" data-carousel-next>
        <svg width="14" height="24" viewBox="0 0 14 24" fill="none" aria-hidden="true">
          <path d="M2 2L12 12L2 22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  .art-posters {
    overflow: hidden;
  }

  .art-posters__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--section-pad-x);
  }

  .art-posters__content {
    max-width: 380px;
  }

  .art-posters__content .label {
    display: block;
    margin-bottom: 0.75rem;
  }

  .art-posters__content h1 {
    margin-bottom: 0.75rem;
  }

  .art-posters__content .body-text {
    margin-bottom: 1.5rem;
  }

  .art-posters__carousel-col {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }

  .art-posters__carousel-wrap {
    overflow: hidden;
    flex: 1;
    min-width: 0;
  }

  .art-posters__carousel {
    display: flex;
    gap: 1.25rem;
    transition: transform 0.4s ease;
  }

  .art-posters__card-wrap {
    flex: 0 0 180px;
  }

  .carousel-arrow {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--maroon);
    color: var(--maroon);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition);
  }

  .carousel-arrow:hover {
    background: var(--maroon);
    color: var(--cream);
  }

  @media (max-width: 900px) {
    .art-posters__layout {
      grid-template-columns: 1fr;
    }

    .art-posters__content {
      max-width: none;
      text-align: center;
    }
  }
</style>

<script>
  const wrap = document.querySelector('[data-carousel-wrap]');
  const carousel = document.querySelector('[data-carousel]');
  const prev = document.querySelector('[data-carousel-prev]');
  const next = document.querySelector('[data-carousel-next]');
  if (wrap && carousel && prev && next) {
    let offset = 0;
    const step = 200;
    const maxOffset = () => Math.max(0, carousel.scrollWidth - wrap.clientWidth);

    prev.addEventListener('click', () => {
      offset = Math.max(0, offset - step);
      carousel.style.transform = `translateX(-${offset}px)`;
    });
    next.addEventListener('click', () => {
      offset = Math.min(maxOffset(), offset + step);
      carousel.style.transform = `translateX(-${offset}px)`;
    });
  }
</script>
