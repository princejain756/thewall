---
const features = [
  {
    icon: 'medal',
    title: 'Premium Quality',
    description: 'Museum grade prints on fine art paper.',
  },
  {
    icon: 'lock',
    title: 'Secure Packaging',
    description: 'Thoughtfully packed to reach you safely.',
  },
  {
    icon: 'heart',
    title: 'Made With Love',
    description: 'Designed and printed in India.',
  },
  {
    icon: 'truck',
    title: 'Pan India Delivery',
    description: 'Delivering memories to your doorstep.',
  },
];
---

<section class="section section--maroon features-section" id="gifting">
  <div class="container split-section">
    <div class="split-section__content">
      <span class="label">A Gift That Lasts</span>
      <h2 class="heading-serif">turn moments into keepsakes.</h2>
      <p class="body-text">
        People don't buy posters — they buy nostalgia, identity, inspiration, and moments they never want to forget.
      </p>
      <a href="/shop" class="btn btn--cream">Shop Gifts <span aria-hidden="true">→</span></a>
    </div>

    <div class="features-grid">
      {
        features.map((feature) => (
          <div class="feature-item">
            <div class="feature-item__icon" aria-hidden="true">
              {feature.icon === 'medal' && (
                <svg width="36" height="36" viewBox="0 0 36 36" fill="none">
                  <circle cx="18" cy="14" r="8" stroke="currentColor" stroke-width="1.2" />
                  <path d="M14 22L12 32L18 28L24 32L22 22" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" />
                  <path d="M18 6V4M24 8L25.5 6.5M12 8L10.5 6.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                </svg>
              )}
              {feature.icon === 'lock' && (
                <svg width="36" height="36" viewBox="0 0 36 36" fill="none">
                  <rect x="10" y="16" width="16" height="14" rx="2" stroke="currentColor" stroke-width="1.2" />
                  <path d="M13 16V12C13 8.686 15.686 6 19 6C22.314 6 25 8.686 25 12V16" stroke="currentColor" stroke-width="1.2" />
                  <circle cx="18" cy="23" r="2" fill="currentColor" />
                </svg>
              )}
              {feature.icon === 'heart' && (
                <svg width="36" height="36" viewBox="0 0 36 36" fill="none">
                  <path d="M18 30C18 30 6 22 6 13.5C6 9.36 9.36 6 13.5 6C15.78 6 17.82 7.08 18 8.64C18.18 7.08 20.22 6 22.5 6C26.64 6 30 9.36 30 13.5C30 22 18 30 18 30Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" />
                </svg>
              )}
              {feature.icon === 'truck' && (
                <svg width="36" height="36" viewBox="0 0 36 36" fill="none">
                  <rect x="4" y="12" width="18" height="12" rx="1" stroke="currentColor" stroke-width="1.2" />
                  <path d="M22 16H28L32 20V24H22V16Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" />
                  <circle cx="12" cy="26" r="3" stroke="currentColor" stroke-width="1.2" />
                  <circle cx="27" cy="26" r="3" stroke="currentColor" stroke-width="1.2" />
                </svg>
              )}
            </div>
            <div class="feature-item__copy">
              <h3 class="feature-item__title">{feature.title}</h3>
              <p class="feature-item__desc">{feature.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .features-section .split-section {
    grid-template-columns: minmax(0, 380px) minmax(0, 1fr);
    align-items: start;
  }

  .features-section .split-section__content {
    position: sticky;
    top: calc(var(--nav-h, 68px) + 1rem);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: start;
    min-width: 0;
  }

  .feature-item {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .feature-item__icon {
    color: var(--cream);
    opacity: 0.95;
    margin-bottom: 0.25rem;
  }

  .feature-item__copy {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .feature-item__title {
    font-family: var(--sans);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .feature-item__desc {
    font-size: 0.82rem;
    font-weight: 400;
    line-height: 1.55;
    opacity: 0.88;
    max-width: 22ch;
  }

  @media (max-width: 960px) {
    .features-section {
      scroll-margin-top: 4.5rem;
    }

    .features-section .split-section {
      grid-template-columns: 1fr;
      gap: 1.75rem;
      padding-block: clamp(2.5rem, 8vw, 3.25rem);
    }

    .features-section .split-section__content {
      position: static;
      gap: 1rem;
      padding-block: 0;
    }

    .features-section .label {
      font-size: 0.65rem;
      letter-spacing: 0.2em;
    }

    .features-section .heading-serif {
      font-size: clamp(1.75rem, 7.2vw, 2.15rem);
      line-height: 1.14;
      text-wrap: balance;
      max-width: 16ch;
    }

    .features-section .body-text {
      font-size: 0.92rem;
      line-height: 1.6;
      opacity: 0.92;
    }

    .features-section .btn {
      width: 100%;
      margin-top: 0.25rem;
    }

    .features-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      padding-top: 1.5rem;
      border-top: 1px solid rgba(245, 241, 230, 0.14);
    }

    .feature-item {
      flex-direction: row;
      align-items: flex-start;
      gap: 0.65rem;
      padding: 0.85rem 0.75rem;
      background: rgba(0, 0, 0, 0.08);
      border-radius: 4px;
    }

    .feature-item__icon {
      flex-shrink: 0;
      margin-bottom: 0;
      margin-top: 0.1rem;
    }

    .feature-item__icon :global(svg) {
      width: 28px;
      height: 28px;
    }

  .feature-item__copy {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

    .feature-item__title {
      font-size: 0.8rem;
      line-height: 1.25;
    }

    .feature-item__desc {
      font-size: 0.72rem;
      line-height: 1.4;
      opacity: 0.82;
      max-width: none;
    }
  }
</style>
